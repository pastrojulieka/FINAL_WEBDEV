{% extends 'base.html.twig' %}

{% block title %}Product Index{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Lato', sans-serif;
    }
    h1, h2, h3, h4, h5, h6 {
      font-family: 'Montserrat', sans-serif;
    }
    .glass {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    .gradient-border {
      border: 1px solid transparent;
      background: linear-gradient(white, white) padding-box,
                  linear-gradient(135deg, #ff8c42, #ff5e00) border-box;
    }
    .card {
      transition: all 0.3s ease;
    }
    .card:hover {
      transform: translateY(-8px);
    }
    .card-img-container {
      background: linear-gradient(135deg, #fff5ee 0%, #ffe4cc 100%);
      transition: all 0.3s ease;
    }
    .card:hover .card-img-container {
      background: linear-gradient(135deg, #ffebe0 0%, #ffd4b3 100%);
    }
    
    .search-box {
      position: relative;
      margin-bottom: 24px;
    }
    
    .search-input {
      width: 100%;
      padding: 14px 20px 14px 48px;
      border: 2px solid #fed7aa;
      border-radius: 12px;
      font-size: 1rem;
      transition: all 0.3s ease;
      background: white;
    }
    
    .search-input:focus {
      outline: none;
      border-color: #f97316;
      box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
    }
    
    .search-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #fb923c;
    }
    
    .filter-chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    
    .chip {
      padding: 8px 16px;
      border-radius: 20px;
      border: 2px solid #fed7aa;
      background: white;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      color: #9a3412;
    }
    
    .chip:hover, .chip.active {
      border-color: #f97316;
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
    }
    
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #fb923c;
    }
    
    .empty-state i {
      font-size: 4rem;
      margin-bottom: 16px;
      opacity: 0.3;
      color: #fdba74;
    }
  </style>
{% endblock %}

{% block body %}
<body class="antialiased bg-gradient-to-br from-orange-50 via-gray-50 to-orange-200 text-gray-800 min-h-screen">

  <div class="min-h-screen flex">

  <!-- SIDEBAR -->
    <aside class="hidden md:flex flex-col w-80 bg-white shadow-lg border-r border-gray-200 p-5">
      <div class="flex items-center justify-center mb-8">
        <img src="{{ asset('img/PL.png') }}" alt="Logo" class="w-45">
      </div>

      <nav class="flex-1 space-y-2">
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-chart-line"></i> Dashboard
        </a>
        {% elseif is_granted('ROLE_STAFF') %}
        <a href="{{ path('app_staff_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-chart-line"></i> Dashboard
        </a>
        {% endif %}
        <a href="{{ path('app_product_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium bg-gradient-to-r from-orange-500 to-orange-400 text-white shadow-md">
          <i class="fa-solid fa-box"></i> Products
        </a>
        <a href="{{ path('app_order_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-receipt"></i> Orders
        </a>
        <a href="{{ path('app_stock_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-warehouse"></i> Stock
        </a>
        <a href="{{ path('app_customer_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-users"></i> Customers
        </a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin_users') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-user-shield"></i> User Management
        </a>
        <a href="{{ path('app_admin_records') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-database"></i> All Records
        </a>
        <a href="{{ path('app_admin_activity_logs') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-clipboard-list"></i> Activity Logs
        </a>
        <a href="{{ path('app_settings') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-gear"></i> Settings
        </a>
        {% endif %}
      </nav>

      <div class="mt-6">
        <p class="text-xs uppercase text-gray-400 mb-2 font-montserrat tracking-wide">Quick actions</p>
        <a href="{{ path('app_logout') }}" class="w-full py-2 rounded-lg text-white font-medium shadow-md hover:shadow-lg transition transform hover:scale-105 block text-center"
                style="background: linear-gradient(135deg, #ff7a1f, #ff6600);">
          <i class="fa-solid fa-right-from-bracket mr-1"></i> Logout
        </a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="flex-1 flex flex-col relative overflow-hidden">

      <!-- Animated background glow -->
      <div class="absolute inset-0 overflow-hidden z-0">
        <div class="absolute w-72 h-72 bg-orange-300 opacity-20 rounded-full blur-3xl top-10 left-20 animate-pulse"></div>
        <div class="absolute w-96 h-96 bg-orange-400 opacity-30 rounded-full blur-3xl bottom-0 right-10 animate-pulse"></div>
      </div>

      <!-- HEADER -->
      <header class="flex items-center justify-between p-5 bg-white/80 backdrop-blur-md shadow-md border-b border-orange-100 sticky top-0 z-10">
        <div class="flex items-center gap-3">
          <button id="mobileMenuBtn" class="md:hidden p-2 rounded-md hover:bg-gray-100">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div>
            <h1 class="text-2xl font-bold text-gray-800 font-montserrat">Products</h1>
            <p class="text-sm text-gray-500 font-lato">Manage and organize your product catalog</p>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <button class="px-3 py-2 rounded-full bg-white border border-gray-200 hover:bg-orange-50 transition relative shadow-sm">
            <i class="fa-solid fa-bell text-orange-500"></i>
            <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full animate-ping"></span>
            <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full"></span>
          </button>

          <div class="flex items-center gap-3">
            <img src="{{ asset('img/Bed.png') }}" alt="avatar" class="w-10 h-10 rounded-full border-2 border-orange-400 object-cover shadow-md" />
            <div class="hidden sm:block text-sm">
              {% if app.user %}
                <div class="font-semibold text-gray-800 font-lato">{{ app.user.email }}</div>
                <div class="text-xs text-gray-500 font-lato">
                  {% if is_granted('ROLE_ADMIN') %}
                    Admin
                  {% elseif is_granted('ROLE_STAFF') %}
                    Staff
                  {% else %}
                    User
                  {% endif %}
                </div>
              {% else %}
                <div class="font-semibold text-gray-800 font-lato">Guest</div>
                <div class="text-xs text-gray-500 font-lato">Public User</div>
              {% endif %}
            </div>
          </div>
        </div>
      </header>

      <!-- PRODUCT CARDS -->
      <main class="p-6 md:p-10 flex-1 overflow-y-auto relative z-10">
        <div class="max-w-7xl mx-auto">
          <!-- Header Section -->
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
            <div>
              <h2 class="text-3xl font-bold text-orange-600 tracking-tight mb-1">Product Catalog</h2>
              <p class="text-gray-600"><span id="productCount">{{ products|length }}</span> products available</p>
            </div>
            <a href="{{ path('app_product_new') }}"
               class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl">
              <i class="fa-solid fa-plus"></i> Add New Product
            </a>
          </div>

          <!-- Search Box -->
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" 
                   id="searchInput" 
                   class="search-input" 
                   placeholder="Search by name, material, color, or description...">
          </div>

          <!-- Filter Chips -->
          <div class="filter-chips">
            <button class="chip active" data-filter="all">
              <i class="fa-solid fa-border-all mr-1"></i> All Products
            </button>
            <button class="chip" data-filter="price-low">
              <i class="fa-solid fa-arrow-down-short-wide mr-1"></i> Price: Low to High
            </button>
            <button class="chip" data-filter="price-high">
              <i class="fa-solid fa-arrow-up-wide-short mr-1"></i> Price: High to Low
            </button>
            <button class="chip" data-filter="name-az">
              <i class="fa-solid fa-arrow-down-a-z mr-1"></i> Name: A-Z
            </button>
            <button class="chip" data-filter="name-za">
              <i class="fa-solid fa-arrow-up-z-a mr-1"></i> Name: Z-A
            </button>
          </div>

          <!-- Cards Grid -->
          {% if products %}
            <div id="productGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {% for item in productsWithStatus %}
                {% set product = item.product %}
                {% set stockStatus = item.stockStatus %}
                <div class="card bg-white rounded-xl shadow-lg overflow-hidden border border-orange-100 hover:shadow-2xl"
                     data-name="{{ product.name|lower }}"
                     data-material="{{ product.material|lower }}"
                     data-color="{{ product.color|lower }}"
                     data-description="{{ product.description|lower }}"
                     data-price="{{ product.price }}">
                  <!-- Image Section -->
                  <div class="card-img-container relative h-48 flex items-center justify-center p-4">
                    {% if product.image %}
                      <img src="{{ asset('img/' ~ product.image) }}" 
                           alt="{{ product.name }}" 
                           class="w-full h-full object-contain">
                    {% else %}
                      <div class="flex flex-col items-center justify-center text-orange-300">
                        <i class="fa-solid fa-image text-5xl mb-2"></i>
                        <span class="text-sm text-gray-400">No image</span>
                      </div>
                    {% endif %}
                    <div class="absolute top-2 right-2 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-full">
                      #{{ product.id }}
                    </div>
                    <div class="absolute top-2 left-2">
                      <span class="px-2 py-1 rounded-full text-xs font-semibold {{ stockStatus == 'In Stock' ? 'bg-green-100 text-green-800' : stockStatus == 'Low Stock' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' }}">
                        {{ stockStatus }}
                      </span>
                    </div>
                  </div>

                  <!-- Content Section -->
                  <div class="p-5">
                    <h3 class="text-lg font-bold text-gray-800 mb-2 truncate">{{ product.name }}</h3>
                    
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2 h-10">
                      {{ product.description }}
                    </p>

                    <!-- Price -->
                    <div class="mb-4">
                      <div class="flex items-baseline gap-1">
                        <i class="fa-solid fa-peso-sign text-orange-600 text-sm"></i>
                        <span class="text-2xl font-bold text-orange-600">{{ product.price }}</span>
                      </div>
                    </div>

                    <!-- Product Details -->
                    <div class="space-y-2 mb-4 pb-4 border-b border-gray-100">
                      <div class="flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-layer-group text-orange-500 w-4"></i>
                        <span class="text-gray-600">Material:</span>
                        <span class="font-medium text-gray-800">{{ product.material }}</span>
                      </div>
                      <div class="flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-palette text-orange-500 w-4"></i>
                        <span class="text-gray-600">Color:</span>
                        <span class="font-medium text-gray-800">{{ product.color }}</span>
                      </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex gap-2">
                      <a href="{{ path('app_product_show', {'id': product.id}) }}"
                         class="flex-1 flex items-center justify-center gap-2 px-3 py-2 border-2 border-orange-500 text-orange-600 rounded-lg hover:bg-orange-50 transition text-sm font-medium">
                        <i class="fa-solid fa-eye"></i>
                        <span>View</span>
                      </a>
                      <a href="{{ path('app_product_edit', {'id': product.id}) }}"
                         class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-lg hover:scale-105 transition text-sm font-medium shadow-md">
                        <i class="fa-solid fa-pen"></i>
                        <span>Edit</span>
                      </a>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            <!-- Empty State (hidden by default, shown when search has no results) -->
            <div id="emptyState" class="hidden">
              <div class="empty-state">
                <i class="fa-solid fa-search"></i>
                <h3 class="text-xl font-bold text-orange-600 mb-2">No Products Found</h3>
                <p class="text-orange-500">Try adjusting your search or filters</p>
              </div>
            </div>
          {% else %}
            <div class="glass rounded-2xl shadow-xl border border-orange-200 p-12 text-center">
              <i class="fa-solid fa-box-open text-6xl text-orange-300 mb-4"></i>
              <h3 class="text-2xl font-bold text-gray-700 mb-2">No Products Found</h3>
              <p class="text-gray-500 mb-6">Start by adding your first product to the catalog</p>
              <a href="{{ path('app_product_new') }}"
                 class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:scale-105 transition-all duration-200 shadow-lg">
                <i class="fa-solid fa-plus"></i> Add First Product
              </a>
            </div>
          {% endif %}
        </div>

        <footer class="mt-10 text-sm text-gray-500 text-center relative z-10">
          © 2025 <span class="text-orange-500 font-semibold">JULIEKA Admin</span> — All Rights Reserved.
        </footer>
      </main>
    </div>
  </div>

  <script>
    // Mobile menu toggle
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const sidebar = document.querySelector('aside');
    mobileBtn?.addEventListener('click', () => {
      sidebar.classList.toggle('hidden');
    });

    // Search and filter functionality
    const searchInput = document.getElementById('searchInput');
    const productGrid = document.getElementById('productGrid');
    const emptyState = document.getElementById('emptyState');
    const productCount = document.getElementById('productCount');

    // Only initialize if product grid exists
    if (productGrid) {
      const productCards = productGrid.querySelectorAll('.card');
      let currentFilter = 'all';

      function updateProductCount() {
        const visibleCards = Array.from(productCards).filter(card => !card.classList.contains('hidden'));
        productCount.textContent = visibleCards.length;
        
        if (visibleCards.length === 0) {
          productGrid.classList.add('hidden');
          emptyState.classList.remove('hidden');
        } else {
          productGrid.classList.remove('hidden');
          emptyState.classList.add('hidden');
        }
      }

      function applySort(cards, filter) {
        const cardsArray = Array.from(cards);
        
        if (filter === 'price-low') {
          cardsArray.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
        } else if (filter === 'price-high') {
          cardsArray.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
        } else if (filter === 'name-az') {
          cardsArray.sort((a, b) => a.dataset.name.localeCompare(b.dataset.name));
        } else if (filter === 'name-za') {
          cardsArray.sort((a, b) => b.dataset.name.localeCompare(a.dataset.name));
        }
        
        // Re-append cards in sorted order
        cardsArray.forEach(card => productGrid.appendChild(card));
      }

      // Live Search functionality
      searchInput.addEventListener('input', (e) => {
        const searchTerm = e.target.value.toLowerCase();
        
        productCards.forEach(card => {
          const name = card.dataset.name;
          const material = card.dataset.material;
          const color = card.dataset.color;
          const description = card.dataset.description;
          
          const matches = name.includes(searchTerm) || 
                         material.includes(searchTerm) || 
                         color.includes(searchTerm) || 
                         description.includes(searchTerm);
          
          if (matches) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
        
        updateProductCount();
      });

      // Filter functionality (sorting)
      const filterChips = document.querySelectorAll('.chip');
      
      filterChips.forEach(chip => {
        chip.addEventListener('click', () => {
          // Update active state
          filterChips.forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          
          currentFilter = chip.dataset.filter;
          
          // Show all cards first
          productCards.forEach(card => card.classList.remove('hidden'));
          
          // Apply sorting
          if (currentFilter !== 'all') {
            applySort(productCards, currentFilter);
          }
          
          // Clear search when changing filters
          searchInput.value = '';
          updateProductCount();
        });
      });
    }
  </script>
</body>
{% endblock %}