<div id="liveOrderToast" class="fixed top-5 right-5 z-50 hidden transform transition-all duration-300 translate-x-full opacity-0">
  <div class="bg-white border-2 border-orange-400 shadow-2xl rounded-xl px-5 py-4 flex items-center gap-3 max-w-sm">
    <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center flex-shrink-0">
      <i class="fa-solid fa-bell text-orange-600"></i>
    </div>
    <div>
      <p class="font-semibold text-gray-800 text-sm" id="liveOrderToastTitle">Update</p>
      <p class="text-xs text-gray-500" id="liveOrderToastMessage">Data refreshed automatically</p>
    </div>
  </div>
</div>

<script>
(function () {
  const POLL_MS = 4000;

  function showToast(title, message) {
    const toast = document.getElementById('liveOrderToast');
    if (!toast) return;
    document.getElementById('liveOrderToastTitle').textContent = title;
    document.getElementById('liveOrderToastMessage').textContent = message;
    toast.classList.remove('hidden');
    requestAnimationFrame(() => toast.classList.remove('translate-x-full', 'opacity-0'));
    setTimeout(() => {
      toast.classList.add('translate-x-full', 'opacity-0');
      setTimeout(() => toast.classList.add('hidden'), 300);
    }, 4500);
  }

  async function fetchLive(url, version) {
    const sep = url.includes('?') ? '&' : '?';
    const fullUrl = version ? `${url}${sep}version=${encodeURIComponent(version)}` : url;
    const res = await fetch(fullUrl, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
    });
    if (!res.ok) return null;
    const data = await res.json();
    return data?.success ? data : null;
  }

  window.LiveResource = {
    pollUrl: null,
    version: '',
    count: 0,
    targetSelector: null,
    onUpdate: null,
    toastTitle: 'Updated',

    async poll() {
      if (!this.pollUrl) return;
      try {
        const data = await fetchLive(this.pollUrl, this.version);
        if (!data) return;

        if (data.changed) {
          const prev = this.version;
          const prevCount = this.count;
          this.version = data.version;
          this.count = data.count ?? this.count;

          if (this.targetSelector && data.html) {
            const el = document.querySelector(this.targetSelector);
            if (el) el.innerHTML = data.html;
          }
          if (typeof this.onUpdate === 'function') {
            this.onUpdate(data, prevCount);
          }
          if (prev && prev !== data.version) {
            showToast(this.toastTitle, this.toastMessage || 'List refreshed automatically');
          }
        } else if (data.version) {
          this.version = data.version;
        }
      } catch (e) {
        console.debug('LiveResource poll skipped:', e);
      }
    },

    start(pollUrl, targetSelector, options) {
      options = options || {};
      this.pollUrl = pollUrl;
      this.targetSelector = targetSelector;
      this.onUpdate = options.onUpdate || null;
      this.count = options.initialCount ?? 0;
      this.toastTitle = options.toastTitle || 'Updated';
      this.toastMessage = options.toastMessage || 'Data refreshed automatically';
      this.poll();
      setInterval(() => this.poll(), POLL_MS);
    },
  };

  window.LiveOrders = {
    start(pollUrl, onUpdate, initialCount) {
      LiveResource.start(pollUrl, '#orderGrid', {
        initialCount,
        onUpdate: (data, prevCount) => {
          const countEl = document.getElementById('orderCount');
          if (countEl && data.count !== undefined) countEl.textContent = data.count;
          if (typeof onUpdate === 'function') onUpdate(data, prevCount);
        },
        toastTitle: 'New order received',
        toastMessage: 'Orders list updated',
      });
    },
  };

  window.LiveDashboard = {
    pollUrl: null,
    version: '',

    statMap: {
      totalRevenue: 'liveTotalRevenue',
      revenueDesc: 'liveRevenueDesc',
      totalOrders: 'liveTotalOrders',
      ordersDesc: 'liveOrdersDesc',
      totalCustomers: 'liveTotalCustomers',
      totalProducts: 'liveTotalProducts',
      totalStock: 'liveTotalStock',
      myOrders: 'liveMyOrders',
      myProducts: 'liveMyProducts',
      myStock: 'liveMyStock',
      myCustomers: 'liveMyCustomers',
      totalRecords: 'liveTotalRecords',
    },

    applyStats(stats, options) {
      options = options || {};
      if (!stats) return;

      Object.keys(this.statMap).forEach((key) => {
        if (Object.prototype.hasOwnProperty.call(stats, key)) {
          const el = document.getElementById(this.statMap[key]);
          if (el) el.textContent = stats[key];
        }
      });

      if (options.activitiesHtml) {
        const c = document.getElementById('liveActivities');
        if (c) c.innerHTML = options.activitiesHtml;
      }

      if (options.dashboardVersion) {
        this.version = options.dashboardVersion;
      }

      if (options.showToast) {
        showToast('Dashboard updated', options.toastMessage || 'Revenue and stats updated automatically');
      }
    },

    async poll() {
      if (!this.pollUrl) return;
      try {
        const data = await fetchLive(this.pollUrl, this.version);
        if (!data) return;

        if (data.changed) {
          const prev = this.version;
          this.version = data.version;
          this.applyStats(data.stats, {
            activitiesHtml: data.activitiesHtml,
            showToast: !!prev,
            toastMessage: 'Revenue and stats updated automatically',
          });
        } else if (data.version) {
          this.version = data.version;
        }
      } catch (e) {
        console.debug('LiveDashboard poll skipped:', e);
      }
    },

    start(pollUrl) {
      this.pollUrl = pollUrl;
      this.poll();
      setInterval(() => this.poll(), POLL_MS);
    },
  };

  window.addEventListener('dashboard:stats', function (event) {
    if (!event.detail?.stats) return;
    window.LiveDashboard.applyStats(event.detail.stats, {
      dashboardVersion: event.detail.dashboardVersion,
      showToast: !!event.detail.showToast,
      toastMessage: event.detail.toastMessage,
    });
  });
})();
</script>
