<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
              integrity="sha512-xh6lHJ96jSt6i9Y0b6XTvjZf9Dy7DKN+lJST8zxvSg2PPCQbCduy7YlqCjohZB0knGf7aZHPN0W8cPZ7Z1FZw=="
              crossorigin="anonymous"
              referrerpolicy="no-referrer" />

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
            
            <style>
                /* Dark Mode Styles */
                .dark-mode {
                    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%) !important;
                }
                
                .dark-mode .bg-white {
                    background-color: #2d2d2d !important;
                }
                
                .dark-mode .bg-white\/80 {
                    background-color: rgba(45, 45, 45, 0.8) !important;
                }
                
                .dark-mode .text-gray-800 {
                    color: #f0f0f0 !important;
                }
                
                .dark-mode .text-gray-500 {
                    color: #a0a0a0 !important;
                }
                
                .dark-mode .text-gray-600 {
                    color: #b0b0b0 !important;
                }
                
                .dark-mode .border-gray-200,
                .dark-mode .border-gray-100 {
                    border-color: #404040 !important;
                }
                
                .dark-mode .border-orange-100 {
                    border-color: #ff9800 !important;
                }
                
                .dark-mode input[type="text"],
                .dark-mode input[type="number"],
                .dark-mode select,
                .dark-mode textarea {
                    background-color: #1a1a1a !important;
                    border-color: #404040 !important;
                    color: #f0f0f0 !important;
                }

                /* Compact View Styles */
                .compact-view main {
                    padding: 1rem !important;
                }
                
                .compact-view .settings-card,
                .compact-view .stat-card,
                .compact-view .bg-white\/80 {
                    padding: 1rem !important;
                }
                
                .compact-view .space-y-5 > div,
                .compact-view .space-y-4 > div {
                    padding-top: 0.5rem !important;
                    padding-bottom: 0.5rem !important;
                }
                
                .compact-view .gap-6 {
                    gap: 1rem !important;
                }
                
                .compact-view .gap-8 {
                    gap: 1.5rem !important;
                }
                
                .compact-view .p-6 {
                    padding: 1rem !important;
                }

                /* No Animations */
                .no-animations * {
                    animation: none !important;
                    transition: none !important;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
        
        <script>
            // Apply saved appearance settings on page load
            (function() {
                const body = document.body;
                
                // Dark Mode
                if (localStorage.getItem('darkMode') === 'enabled') {
                    body.classList.add('dark-mode');
                }
                
                // Compact View
                if (localStorage.getItem('compactView') === 'enabled') {
                    body.classList.add('compact-view');
                }
                
                // Animations
                if (localStorage.getItem('animations') === 'disabled') {
                    body.classList.add('no-animations');
                }
            })();
        </script>
    </body>
</html>