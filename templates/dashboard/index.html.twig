{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        crossorigin="anonymous"
        referrerpolicy="no-referrer" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Lato:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .font-montserrat { font-family: 'Montserrat', sans-serif; }
    .font-lato { font-family: 'Lato', sans-serif; }
    
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    
    .float-animation {
      animation: float 3s ease-in-out infinite;
    }
    
    .stat-card {
      position: relative;
      overflow: hidden;
    }
    
    .stat-card::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
      transition: transform 0.5s ease;
    }
    
    .stat-card:hover::before {
      transform: scale(1.5);
    }
  </style>
{% endblock %}

{% block body %}
<body class="antialiased bg-gradient-to-br from-orange-50 via-gray-50 to-orange-100 text-gray-800 min-h-screen font-lato">
  <div class="min-h-screen flex">
    
    <!-- SIDEBAR -->
    <aside class="hidden md:flex flex-col w-80 bg-white shadow-lg border-r border-gray-200 p-5">
      <div class="flex items-center justify-center mb-8">
        <img src="{{ asset('img/PL.png') }}" alt="Logo" class="w-45">
      </div>

      <nav class="flex-1 space-y-2">
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium bg-gradient-to-r from-orange-500 to-orange-400 text-white shadow-md">
          <i class="fa-solid fa-chart-line"></i> Dashboard
        </a>
        {% elseif is_granted('ROLE_STAFF') %}
        <a href="{{ path('app_staff_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium bg-gradient-to-r from-orange-500 to-orange-400 text-white shadow-md">
          <i class="fa-solid fa-chart-line"></i> Dashboard
        </a>
        {% endif %}
        <a href="{{ path('app_product_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-box"></i> Products
        </a>
        <a href="{{ path('app_order_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-receipt"></i> Orders
        </a>
        <a href="{{ path('app_stock_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-warehouse"></i> Stock
        </a>
        <a href="{{ path('app_customer_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-users"></i> Customers
        </a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin_users') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-user-shield"></i> User Management
        </a>
        <a href="{{ path('app_admin_records') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-database"></i> All Records
        </a>
        <a href="{{ path('app_admin_activity_logs') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-clipboard-list"></i> Activity Logs
        </a>
        <a href="{{ path('app_settings') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-gear"></i> Settings
        </a>
        {% endif %}
      </nav>

      <div class="mt-6">
        <p class="text-xs uppercase text-gray-400 mb-2 font-montserrat tracking-wide">Quick actions</p>
        <a href="{{ path('app_logout') }}" class="w-full py-2 rounded-lg text-white font-medium shadow-md hover:shadow-lg transition transform hover:scale-105 block text-center"
                style="background: linear-gradient(135deg, #ff7a1f, #ff6600);">
          <i class="fa-solid fa-right-from-bracket mr-1"></i> Logout
        </a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="flex-1 flex flex-col relative overflow-hidden">
      
      <!-- Animated Background Elements -->
      <div class="absolute inset-0 overflow-hidden z-0 pointer-events-none">
        <div class="absolute w-96 h-96 bg-orange-300 opacity-20 rounded-full blur-3xl -top-20 -left-20 float-animation"></div>
        <div class="absolute w-80 h-80 bg-orange-400 opacity-25 rounded-full blur-3xl top-40 right-10 float-animation" style="animation-delay: 1s;"></div>
        <div class="absolute w-64 h-64 bg-orange-200 opacity-20 rounded-full blur-3xl bottom-20 left-1/3 float-animation" style="animation-delay: 2s;"></div>
      </div>

      <!-- HEADER -->
      <header class="flex items-center justify-between p-5 bg-white/80 backdrop-blur-md shadow-md border-b border-orange-100 sticky top-0 z-10">
        <div class="flex items-center gap-3">
          <button id="mobileMenuBtn" class="md:hidden p-2 rounded-md hover:bg-gray-100">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div>
            <h1 class="text-2xl font-bold text-gray-800 font-montserrat">Dashboard Overview</h1>
            <p class="text-sm text-gray-500 font-lato">Real-time statistics & insights</p>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="relative hidden lg:block">
            <form action="{{ path('app_search') }}" method="GET">
              <input type="text" name="q" placeholder="Search anything..."
                     class="w-72 pl-4 pr-10 py-2.5 rounded-lg border border-gray-200 bg-white text-sm focus:ring-2 focus:ring-orange-400 focus:border-orange-400 focus:outline-none transition font-lato shadow-sm" />
              <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-orange-600 transition">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </form>
          </div>

          <button class="px-3 py-2 rounded-full bg-white border border-gray-200 hover:bg-orange-50 transition relative shadow-sm">
            <i class="fa-solid fa-bell text-orange-500"></i>
            <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full animate-ping"></span>
            <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full"></span>
          </button>

          <div class="flex items-center gap-3">
            <img src="{{ asset('img/Julieka.jpg') }}" alt="avatar" class="w-10 h-10 rounded-full border-2 border-orange-400 object-cover shadow-md" />
            <div class="hidden sm:block text-sm">
              <div class="font-semibold text-gray-800 font-lato">Julieka Pastro</div>
              <div class="text-xs text-gray-500 font-lato">Admin</div>
            </div>
          </div>
        </div>
      </header>

      <!-- CONTENT -->
      <main class="p-6 flex-1 overflow-y-auto relative z-5">
        
        <!-- STATISTICS CARDS -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          {# Stats are now passed from the controller #}
          {% for stat in stats %}
            <div class="stat-card group p-6 rounded-xl shadow-lg border border-orange-200/50 bg-gradient-to-br {{ stat.gradient }} text-white hover:scale-105 hover:shadow-2xl transition-all duration-300 relative">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1">
                  <div class="text-sm font-medium opacity-90 font-lato uppercase tracking-wide">{{ stat.label }}</div>
                </div>
                <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm group-hover:bg-white/30 transition-colors">
                  <i class="fa-solid {{ stat.icon }} text-2xl"></i>
                </div>
              </div>
              
              <div class="mt-3 text-3xl font-extrabold font-montserrat"{% if stat.label == 'Total Revenue' %} id="liveTotalRevenue"{% elseif stat.label == 'Total Orders' %} id="liveTotalOrders"{% elseif stat.label == 'Total Customers' %} id="liveTotalCustomers"{% elseif stat.label == 'Total Products' %} id="liveTotalProducts"{% elseif stat.label == 'Stock' %} id="liveTotalStock"{% elseif stat.label == 'My Orders' %} id="liveMyOrders"{% endif %}>{{ stat.value }}</div>
              
              <div class="flex items-center gap-2 mt-3">
                {% if stat.trend == 'up' %}
                  <span class="flex items-center gap-1 text-xs bg-white/20 px-2 py-1 rounded-full backdrop-blur-sm font-lato"{% if stat.label == 'Total Revenue' %} id="liveRevenueDesc"{% elseif stat.label == 'Total Orders' %} id="liveOrdersDesc"{% endif %}>
                    <i class="fa-solid fa-arrow-trend-up"></i> {{ stat.desc }}
                  </span>
                {% elseif stat.trend == 'down' %}
                  <span class="flex items-center gap-1 text-xs bg-white/20 px-2 py-1 rounded-full backdrop-blur-sm font-lato"{% if stat.label == 'Total Revenue' %} id="liveRevenueDesc"{% elseif stat.label == 'Total Orders' %} id="liveOrdersDesc"{% endif %}>
                    <i class="fa-solid fa-arrow-trend-down"></i> {{ stat.desc }}
                  </span>
                {% else %}
                  <span class="flex items-center gap-1 text-xs bg-white/20 px-2 py-1 rounded-full backdrop-blur-sm font-lato"{% if stat.label == 'Total Revenue' %} id="liveRevenueDesc"{% elseif stat.label == 'Total Orders' %} id="liveOrdersDesc"{% endif %}>
                    <i class="fa-solid fa-check-circle"></i> {{ stat.desc }}
                  </span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </section>

        <!-- QUICK ACTIONS -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
          <a href="{{ path('app_product_new') }}" class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-orange-100 hover:shadow-xl transition-all duration-300 block">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center shadow-md">
                <i class="fa-solid fa-plus text-white text-xl"></i>
              </div>
              <h3 class="text-lg font-bold text-gray-800 font-montserrat">New Product</h3>
            </div>
            <p class="text-sm text-gray-600 mb-4 font-lato">Add a new product to your inventory</p>
            <div class="w-full py-2 bg-gradient-to-r from-orange-500 to-orange-400 text-white rounded-lg font-medium hover:shadow-lg transition transform hover:scale-105 font-lato text-center">
              Create Product
            </div>
          </a>

          <a href="{{ path('app_order_new') }}" class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-orange-100 hover:shadow-xl transition-all duration-300 block">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center shadow-md">
                <i class="fa-solid fa-cart-plus text-white text-xl"></i>
              </div>
              <h3 class="text-lg font-bold text-gray-800 font-montserrat">Add New Order</h3>
            </div>
            <p class="text-sm text-gray-600 mb-4 font-lato">Create a new order for customers</p>
            <div class="w-full py-2 bg-gradient-to-r from-orange-500 to-orange-400 text-white rounded-lg font-medium hover:shadow-lg transition transform hover:scale-105 font-lato text-center">
              New Order
            </div>
          </a>

          <a href="{{ path('app_customer_new') }}" class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-orange-100 hover:shadow-xl transition-all duration-300 block">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center shadow-md">
                <i class="fa-solid fa-user-plus text-white text-xl"></i>
              </div>
              <h3 class="text-lg font-bold text-gray-800 font-montserrat">Add Customer</h3>
            </div>
            <p class="text-sm text-gray-600 mb-4 font-lato">Register a new customer account</p>
            <div class="w-full py-2 bg-gradient-to-r from-orange-500 to-orange-400 text-white rounded-lg font-medium hover:shadow-lg transition transform hover:scale-105 font-lato text-center">
              Add Customer
            </div>
          </a>
        </section>

        <!-- RECENT ACTIVITY -->
        <section class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-orange-100">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-clock-rotate-left text-white"></i>
              </div>
              <h2 class="text-xl font-bold text-gray-800 font-montserrat">Recent Activity</h2>
            </div>
            <a href="{{ path('app_order_index') }}" class="text-orange-600 hover:text-orange-700 font-medium text-sm font-lato flex items-center gap-1">
              View All <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>
          
          <div class="space-y-4" id="liveActivities">
            {# Activities are now passed from the controller #}
            {% if activities is empty %}
              <div class="text-center py-12">
                <i class="fa-solid fa-inbox text-5xl text-gray-300 mb-4"></i>
                <p class="text-gray-500 font-lato">No recent activity yet. Start by creating orders or adding products.</p>
              </div>
            {% else %}
              {% for activity in activities %}
                <div class="flex items-start gap-4 p-4 rounded-lg hover:bg-orange-50 transition-colors border border-transparent hover:border-orange-200">
                  <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid {{ activity.icon }} text-orange-600"></i>
                  </div>
                  <div class="flex-1">
                    <div class="font-semibold text-gray-800 font-lato">{{ activity.title }}</div>
                    <div class="text-sm text-gray-600 font-lato">{{ activity.desc }}</div>
                  </div>
                  <div class="text-xs text-gray-500 font-lato whitespace-nowrap">{{ activity.time }}</div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </section>

        <!-- FOOTER -->
        <footer class="mt-12 pt-6 border-t border-gray-200 text-center">
          <p class="text-sm text-gray-500 font-lato">
            © 2025 <span class="text-orange-600 font-semibold font-montserrat">JULIEKA Admin</span>. All rights reserved.
          </p>
          <p class="text-xs text-gray-400 mt-1 font-lato">Built with modern web technologies</p>
        </footer>
      </main>
    </div>
  </div>

  <script>
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const sidebar = document.querySelector('aside');
    mobileBtn?.addEventListener('click', () => {
      sidebar.classList.toggle('hidden');
    });
  </script>

  {% include 'includes/_live_poll.html.twig' %}
  <script>
    LiveDashboard.start('{{ path('app_live_dashboard') }}');
  </script>
</body>
{% endblock %}