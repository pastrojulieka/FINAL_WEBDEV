<!-- Flash Messages -->
{% for label, messages in app.flashes %}
  {% if label == 'error' %}
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-circle-exclamation text-red-600 mt-1"></i>
        <div class="flex-1">
          <h4 class="font-semibold text-red-800 mb-2">Form Errors:</h4>
          <ul class="list-disc list-inside space-y-1">
            {% for message in messages %}
              <li class="text-red-700">{{ message }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  {% elseif label == 'success' %}
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-circle-check text-green-600 mt-1"></i>
        <div>
          <h4 class="font-semibold text-green-800">{{ message }}</h4>
        </div>
      </div>
    </div>
  {% endif %}
{% endfor %}

{{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': 'novalidate'}}) }}
  {{ form_row(form.product, {
    label: 'Product',
    attr: {'class': 'w-full border-2 border-orange-100 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-400'}
  }) }}
  {{ form_row(form.quantity, {
    label: 'Quantity',
    attr: {'min': 0, 'class': 'w-full border-2 border-orange-100 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-400'}
  }) }}
  {{ form_row(form.status, {
    label: 'Status',
    attr: {'class': 'w-full border-2 border-orange-100 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-400'}
  }) }}
  <button class="mt-2 inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-lg font-semibold hover:scale-105 transition shadow-md">
    <i class="fa-solid fa-floppy-disk"></i> {{ button_label|default('Save') }}
  </button>
{{ form_end(form) }}

