{% extends 'base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Lato', sans-serif;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Montserrat', sans-serif;
        }
    </style>
{% endblock %}

{% block body %}
<body class="antialiased bg-gradient-to-br from-orange-50 via-gray-50 to-orange-200 text-gray-800 min-h-screen">

    <div class="min-h-screen flex">
        {% include 'includes/_sidebar.html.twig' %}

        <!-- MAIN CONTENT -->
        <div class="flex-1 flex flex-col relative overflow-hidden">
            <!-- Animated background glow -->
            <div class="absolute inset-0 overflow-hidden z-0">
                <div class="absolute w-72 h-72 bg-orange-300 opacity-20 rounded-full blur-3xl top-10 left-20 animate-pulse"></div>
                <div class="absolute w-96 h-96 bg-orange-400 opacity-30 rounded-full blur-3xl bottom-0 right-10 animate-pulse"></div>
            </div>

            <!-- HEADER -->
            <header class="flex items-center justify-between p-5 bg-white/80 backdrop-blur-md shadow-md border-b border-orange-100 sticky top-0 z-10">
                <div class="flex items-center gap-3">
                    <button id="mobileMenuBtn" class="md:hidden p-2 rounded-md hover:bg-gray-100">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="text-2xl font-bold text-gray-800 font-montserrat">User Management</h1>
                        <p class="text-sm text-gray-500 font-lato">Manage users and staff accounts</p>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="relative hidden lg:block">
                        <form action="{{ path('app_search') }}" method="GET">
                            <input type="text" name="q" placeholder="Search anything..."
                                   class="w-72 pl-4 pr-10 py-2.5 rounded-lg border border-gray-200 bg-white text-sm focus:ring-2 focus:ring-orange-400 focus:border-orange-400 focus:outline-none transition font-lato shadow-sm" />
                            <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-orange-600 transition">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                        </form>
                    </div>

                    <button class="px-3 py-2 rounded-full bg-white border border-gray-200 hover:bg-orange-50 transition relative shadow-sm">
                        <i class="fa-solid fa-bell text-orange-500"></i>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full animate-ping"></span>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full"></span>
                    </button>

                    <div class="flex items-center gap-3">
                        <img src="{{ asset('img/Julieka.jpg') }}" alt="avatar" class="w-10 h-10 rounded-full border-2 border-orange-400 object-cover shadow-md" />
                        <div class="hidden sm:block text-sm">
                            <div class="font-semibold text-gray-800 font-lato">Julieka Pastro</div>
                            <div class="text-xs text-gray-500 font-lato">Admin</div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- MAIN CONTENT -->
            <main class="p-6 md:p-10 flex-1 overflow-y-auto relative z-10">
                <div class="max-w-7xl mx-auto">
                    <!-- Flash Messages -->
                    {% for message in app.flashes('success') %}
                        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
                            <i class="fa-solid fa-check-circle mr-2"></i>{{ message }}
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                            <i class="fa-solid fa-exclamation-circle mr-2"></i>{{ message }}
                        </div>
                    {% endfor %}

                    <!-- Header Section -->
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
                        <div>
                            <h2 class="text-3xl font-bold text-orange-600 tracking-tight mb-1">Users & Staff</h2>
                            <p class="text-gray-600">{{ users|length }} user(s) registered</p>
                        </div>
                        <a href="{{ path('app_admin_users_new') }}"
                           class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl">
                            <i class="fa-solid fa-user-plus"></i> Add New User
                        </a>
                    </div>

                    <!-- Users Table -->
                    {% if users %}
                        <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-orange-100">
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="bg-gradient-to-r from-orange-500 to-orange-600 text-orange-400">
                                        <tr>
                                            <th class="px-6 py-4 text-left text-sm font-semibold font-montserrat">ID</th>
                                            <th class="px-6 py-4 text-left text-sm font-semibold font-montserrat">Email</th>
                                            <th class="px-6 py-4 text-left text-sm font-semibold font-montserrat">Role</th>
                                            <th class="px-6 py-4 text-center text-sm font-semibold font-montserrat">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        {% for user in users %}
                                            <tr class="hover:bg-orange-50 transition-colors">
                                                <td class="px-6 py-4 text-sm text-gray-700 font-medium">#{{ user.id }}</td>
                                                <td class="px-6 py-4 text-sm text-gray-800 font-medium">{{ user.email }}</td>
                                                <td class="px-6 py-4">
                                                    {% set roles = user.roles %}
                                                    {% if 'ROLE_ADMIN' in roles %}
                                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                                                            <i class="fa-solid fa-shield-halved mr-1"></i> Admin
                                                        </span>
                                                    {% elseif 'ROLE_STAFF' in roles %}
                                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                                                            <i class="fa-solid fa-user-tie mr-1"></i> Staff
                                                        </span>
                                                    {% else %}
                                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-800">
                                                            <i class="fa-solid fa-user mr-1"></i> User
                                                        </span>
                                                    {% endif %}
                                                </td>
                                                <td class="px-6 py-4">
                                                    <div class="flex items-center justify-center gap-2">
                                                        <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}"
                                                           class="px-3 py-1.5 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition text-sm font-medium shadow-sm">
                                                            <i class="fa-solid fa-pen mr-1"></i> Edit
                                                        </a>
                                                        {% if user.id != app.user.id %}
                                                            <form method="post" action="{{ path('app_admin_users_delete', {'id': user.id}) }}" 
                                                                  onsubmit="return confirm('Are you sure you want to delete this user?');" 
                                                                  class="inline">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                                <button type="submit" 
                                                                        class="px-3 py-1.5 bg-red-500 text-white rounded-lg hover:bg-red-600 transition text-sm font-medium shadow-sm">
                                                                    <i class="fa-solid fa-trash mr-1"></i> Delete
                                                                </button>
                                                            </form>
                                                        {% else %}
                                                            <span class="px-3 py-1.5 bg-gray-300 text-gray-600 rounded-lg text-sm font-medium cursor-not-allowed">
                                                                <i class="fa-solid fa-ban mr-1"></i> Current User
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        <div class="bg-white rounded-2xl shadow-xl border border-orange-200 p-12 text-center">
                            <i class="fa-solid fa-users text-6xl text-orange-300 mb-4"></i>
                            <h3 class="text-2xl font-bold text-gray-700 mb-2">No Users Yet</h3>
                            <p class="text-gray-500 mb-6">Start by adding your first user or staff member</p>
                            <a href="{{ path('app_admin_users_new') }}"
                               class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:scale-105 transition-all duration-200 shadow-lg">
                                <i class="fa-solid fa-plus"></i> Add First User
                            </a>
                        </div>
                    {% endif %}
                </div>

                <footer class="mt-10 text-sm text-gray-500 text-center relative z-10">
                    © 2025 <span class="text-orange-500 font-semibold">JULIEKA Admin</span> — All Rights Reserved.
                </footer>
            </main>
        </div>
    </div>

    <script>
        const mobileBtn = document.getElementById('mobileMenuBtn');
        const sidebar = document.querySelector('aside');
        mobileBtn?.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');
        });
    </script>
</body>
{% endblock %}


