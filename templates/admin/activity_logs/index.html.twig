{% extends 'base.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Lato', sans-serif; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Montserrat', sans-serif; }
    </style>
{% endblock %}

{% block body %}
<body class="antialiased bg-gradient-to-br from-orange-50 via-gray-50 to-orange-200 text-gray-800 min-h-screen">

    <div class="min-h-screen flex">
        {% include 'includes/_sidebar.html.twig' %}

        <div class="flex-1 flex flex-col relative overflow-hidden">
            <div class="absolute inset-0 overflow-hidden z-0">
                <div class="absolute w-72 h-72 bg-orange-300 opacity-20 rounded-full blur-3xl top-10 left-20 animate-pulse"></div>
                <div class="absolute w-96 h-96 bg-orange-400 opacity-30 rounded-full blur-3xl bottom-0 right-10 animate-pulse"></div>
            </div>

            <header class="flex items-center justify-between p-5 bg-white/80 backdrop-blur-md shadow-md border-b border-orange-100 sticky top-0 z-10">
                <div class="flex items-center gap-3">
                    <button id="mobileMenuBtn" class="md:hidden p-2 rounded-md hover:bg-gray-100">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="text-2xl font-bold text-gray-800 font-montserrat">Activity Logs</h1>
                        <p class="text-sm text-gray-500 font-lato">{{ search ? 'Search results' : 'Latest activity' }} ({{ logs|length }} entries)</p>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-3">
                        <img src="{{ asset('img/Julieka.jpg') }}" alt="avatar" class="w-10 h-10 rounded-full border-2 border-orange-400 object-cover shadow-md" />
                        <div class="hidden sm:block text-sm">
                            <div class="font-semibold text-gray-800 font-lato">{{ app.user.userIdentifier }}</div>
                            <div class="text-xs text-gray-500 font-lato">Admin</div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="p-6 md:p-10 flex-1 overflow-y-auto relative z-10">
                <div class="max-w-7xl mx-auto">
                    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <p class="text-gray-600 text-sm md:text-base">
                            Each row shows <strong>who</strong> acted, their <strong>role</strong>, the <strong>action</strong>, and <strong>when</strong> it happened.
                            Create / Update / Delete rows include the affected record type and ID when available.
                        </p>
                        <div class="flex-shrink-0">
                            <form action="{{ path('app_admin_activity_logs') }}" method="GET" class="flex gap-2">
                                <input type="text" name="search" value="{{ search }}" placeholder="Search logs..."
                                       class="px-4 py-2 rounded-lg border border-gray-200 bg-white text-sm focus:ring-2 focus:ring-orange-400 focus:border-orange-400 focus:outline-none transition font-lato shadow-sm" />
                                <button type="submit" class="px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition font-medium text-sm">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                                {% if search %}
                                    <a href="{{ path('app_admin_activity_logs') }}" class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition font-medium text-sm">
                                        Clear
                                    </a>
                                {% endif %}
                            </form>
                        </div>
                    </div>

                    {% if logs is empty %}
                        <div class="bg-white rounded-2xl shadow-xl border border-orange-200 p-12 text-center">
                            <i class="fa-solid fa-clipboard-list text-6xl text-orange-300 mb-4"></i>
                            <h3 class="text-2xl font-bold text-gray-700 mb-2">No activity yet</h3>
                            <p class="text-gray-500">Logs will appear here after logins, logouts, or when an admin creates, updates, or deletes records.</p>
                        </div>
                    {% else %}
                        <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-orange-100">
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm">
                                    <thead class="bg-gradient-to-r from-orange-500 to-orange-600 text-black">
                                        <tr>
                                            <th class="px-4 py-3 text-left font-semibold font-montserrat">WHEN</th>
                                            <th class="px-4 py-3 text-left font-semibold font-montserrat">USER</th>
                                            <th class="px-4 py-3 text-left font-semibold font-montserrat">ROLE</th>
                                            <th class="px-4 py-3 text-left font-semibold font-montserrat">ACTION</th>
                                            <th class="px-4 py-3 text-left font-semibold font-montserrat">SUBJECT</th>
                                        </tr>
                                    </thead>
                                    <tbody id="liveActivityLogBody" class="divide-y divide-gray-200">
                                        {% include 'admin/activity_logs/_rows.html.twig' %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <footer class="mt-10 text-sm text-gray-500 text-center relative z-10">
                    © {{ "now"|date("Y") }} <span class="text-orange-500 font-semibold">JULIEKA Admin</span> — Activity logs are visible to administrators only.
                </footer>
            </main>
        </div>
    </div>

    <script>
        const mobileBtn = document.getElementById('mobileMenuBtn');
        const sidebar = document.querySelector('aside');
        mobileBtn?.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');
        });
    </script>
    {% include 'includes/_live_poll.html.twig' %}
    <script>
      LiveResource.start('{{ path('app_live_activity_logs') }}{% if search %}?search={{ search|url_encode }}{% endif %}', '#liveActivityLogBody', {
        initialCount: {{ logs|length }},
        toastTitle: 'Activity logs updated',
      });
    </script>
</body>
{% endblock %}
