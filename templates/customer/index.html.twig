{% extends 'base.html.twig' %}

{% block title %}Customer Index{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Lato', sans-serif;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Montserrat', sans-serif;
        }
        .glass {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .customer-card {
            transition: all 0.3s ease;
        }
        .customer-card:hover {
            transform: translateY(-8px);
        }
        
        .search-box {
            position: relative;
            margin-bottom: 24px;
        }
        
        .search-input {
            width: 100%;
            padding: 14px 20px 14px 48px;
            border: 2px solid #fed7aa;
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: white;
        }
        
        .search-input:focus {
            outline: none;
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
        }
        
        .search-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #fb923c;
        }
        
        .filter-chips {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }
        
        .chip {
            padding: 8px 16px;
            border-radius: 20px;
            border: 2px solid #fed7aa;
            background: white;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #9a3412;
        }
        
        .chip:hover, .chip.active {
            border-color: #f97316;
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #fb923c;
        }
        
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 16px;
            opacity: 0.3;
            color: #fdba74;
        }
    </style>
{% endblock %}

{% block body %}
<body class="antialiased bg-gradient-to-br from-orange-50 via-gray-50 to-orange-200 text-gray-800 min-h-screen">

    <div class="min-h-screen flex">

        <!-- SIDEBAR -->
        <aside class="hidden md:flex flex-col w-80 bg-white shadow-lg border-r border-gray-200 p-5">
      <div class="flex items-center justify-center mb-8">
        <img src="{{ asset('img/PL.png') }}" alt="Logo" class="w-45">
      </div>

            <nav class="flex-1 space-y-2">
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
                {% elseif is_granted('ROLE_STAFF') %}
                <a href="{{ path('app_staff_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
                {% endif %}
                <a href="{{ path('app_product_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-box"></i> Products
                </a>
                <a href="{{ path('app_order_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-receipt"></i> Orders
                </a>
                <a href="{{ path('app_stock_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-warehouse"></i> Stock
                </a>
                <a href="{{ path('app_customer_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium bg-gradient-to-r from-orange-500 to-orange-400 text-white shadow-md">
                    <i class="fa-solid fa-users"></i> Customers
                </a>
                {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin_users') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-user-shield"></i> User Management
        </a>
        <a href="{{ path('app_admin_records') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-database"></i> All Records
        </a>
        <a href="{{ path('app_admin_activity_logs') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-clipboard-list"></i> Activity Logs
        </a>
        <a href="{{ path('app_settings') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-gear"></i> Settings
        </a>
        {% endif %}
            </nav>

            <div class="mt-6">
                <p class="text-xs uppercase text-gray-400 mb-2 font-montserrat tracking-wide">Quick actions</p>
                <a href="{{ path('app_logout') }}" class="w-full py-2 rounded-lg text-white font-medium shadow-md hover:shadow-lg transition transform hover:scale-105 block text-center"
                        style="background: linear-gradient(135deg, #ff7a1f, #ff6600);">
                    <i class="fa-solid fa-right-from-bracket mr-1"></i> Logout
                </a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="flex-1 flex flex-col relative overflow-hidden">

            <!-- Animated background glow -->
            <div class="absolute inset-0 overflow-hidden z-0">
                <div class="absolute w-72 h-72 bg-orange-300 opacity-20 rounded-full blur-3xl top-10 left-20 animate-pulse"></div>
                <div class="absolute w-96 h-96 bg-orange-400 opacity-30 rounded-full blur-3xl bottom-0 right-10 animate-pulse"></div>
            </div>

            <!-- HEADER -->
            <header class="flex items-center justify-between p-5 bg-white/80 backdrop-blur-md shadow-md border-b border-orange-100 sticky top-0 z-10">
                <div class="flex items-center gap-3">
                    <button id="mobileMenuBtn" class="md:hidden p-2 rounded-md hover:bg-gray-100">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="text-2xl font-bold text-gray-800 font-montserrat">Customers</h1>
                        <p class="text-sm text-gray-500 font-lato">Manage your customer directory</p>
                    </div>
                </div>

                 <div class="flex items-center gap-4">
          <div class="relative hidden lg:block">
            <form action="{{ path('app_search') }}" method="GET">
              <input type="text" name="q" placeholder="Search anything..."
                     class="w-72 pl-4 pr-10 py-2.5 rounded-lg border border-gray-200 bg-white text-sm focus:ring-2 focus:ring-orange-400 focus:border-orange-400 focus:outline-none transition font-lato shadow-sm" />
              <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-orange-600 transition">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </form>
          </div>

                    <button class="px-3 py-2 rounded-full bg-white border border-gray-200 hover:bg-orange-50 transition relative shadow-sm">
                        <i class="fa-solid fa-bell text-orange-500"></i>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full animate-ping"></span>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full"></span>
                    </button>

                    <div class="flex items-center gap-3">
                        <img src="{{ asset('img/Bed.png') }}" alt="avatar" class="w-10 h-10 rounded-full border-2 border-orange-400 object-cover shadow-md" />
                        <div class="hidden sm:block text-sm">
                            <div class="font-semibold text-gray-800 font-lato">{{ app.user.email }}</div>
                            <div class="text-xs text-gray-500 font-lato">
                                {% if is_granted('ROLE_ADMIN') %}
                                  Admin
                                {% elseif is_granted('ROLE_STAFF') %}
                                  Staff
                                {% else %}
                                  User
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- CUSTOMER CARDS -->
            <main class="p-6 md:p-10 flex-1 overflow-y-auto relative z-10">
                <div class="max-w-7xl mx-auto">
                    <!-- Header Section -->
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
                        <div>
                            <h2 class="text-3xl font-bold text-orange-600 tracking-tight mb-1">Customer Directory</h2>
                            <p class="text-gray-600"><span id="customerCount">{{ customers|length }}</span> customers registered</p>
                        </div>
                        <a href="{{ path('app_customer_new') }}"
                           class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl">
                            <i class="fa-solid fa-user-plus"></i> Add New Customer
                        </a>
                    </div>

                    <!-- Search Box -->
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                        <input type="text" 
                               id="searchInput" 
                               class="search-input" 
                               placeholder="Search by name, email, phone, or address...">
                    </div>

                    <!-- Filter Chips -->
                    <div class="filter-chips">
                        <button class="chip active" data-filter="all">
                            <i class="fa-solid fa-border-all mr-1"></i> All Customers
                        </button>
                        <button class="chip" data-filter="a-f">
                            <i class="fa-solid fa-font mr-1"></i> A-F
                        </button>
                        <button class="chip" data-filter="g-m">
                            <i class="fa-solid fa-font mr-1"></i> G-M
                        </button>
                        <button class="chip" data-filter="n-s">
                            <i class="fa-solid fa-font mr-1"></i> N-S
                        </button>
                        <button class="chip" data-filter="t-z">
                            <i class="fa-solid fa-font mr-1"></i> T-Z
                        </button>
                    </div>

                    <!-- Cards Grid -->
                    {% if customers %}
                        <div id="customerGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {% for customer in customers %}
                                <div class="customer-card bg-white rounded-xl shadow-lg overflow-hidden border-l-4 border-orange-500 hover:shadow-2xl"
                                     data-name="{{ customer.name|lower }}"
                                     data-email="{{ customer.emailAddress|lower }}"
                                     data-phone="{{ customer.phoneNumber|lower }}"
                                     data-address="{{ customer.address|lower }}">
                                    <!-- Card Header -->
                                    <div class="bg-gradient-to-r from-orange-50 to-orange-100 p-5 relative">
                                        <span class="absolute top-3 right-3 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-full">
                                            #{{ customer.id }}
                                        </span>
                                        <div class="flex items-center gap-3">
                                            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white text-2xl font-bold shadow-lg">
                                                {{ customer.name|slice(0, 1)|upper }}
                                            </div>
                                            <div>
                                                <h3 class="text-xl font-bold text-gray-800">{{ customer.name }}</h3>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card Body -->
                                    <div class="p-5 space-y-3">
                                        <div class="flex items-start gap-3">
                                            <i class="fa-solid fa-envelope text-orange-500 w-5 mt-1"></i>
                                            <div class="flex-1">
                                                <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Email</div>
                                                <div class="text-sm text-gray-800 font-medium break-words">{{ customer.emailAddress }}</div>
                                            </div>
                                        </div>

                                        <div class="flex items-start gap-3">
                                            <i class="fa-solid fa-phone text-orange-500 w-5 mt-1"></i>
                                            <div class="flex-1">
                                                <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Phone</div>
                                                <div class="text-sm text-gray-800 font-medium">{{ customer.phoneNumber }}</div>
                                            </div>
                                        </div>

                                        <div class="flex items-start gap-3">
                                            <i class="fa-solid fa-map-marker-alt text-orange-500 w-5 mt-1"></i>
                                            <div class="flex-1">
                                                <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Address</div>
                                                <div class="text-sm text-gray-800 font-medium line-clamp-2">{{ customer.address }}</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card Footer -->
                                    <div class="p-5 pt-0 flex gap-2">
                                        <a href="{{ path('app_customer_show', {'id': customer.id}) }}"
                                           class="flex-1 flex items-center justify-center gap-2 px-3 py-2 border-2 border-orange-500 text-orange-600 rounded-lg hover:bg-orange-50 transition text-sm font-medium">
                                            <i class="fa-solid fa-eye"></i>
                                            <span>View</span>
                                        </a>
                                        <a href="{{ path('app_customer_edit', {'id': customer.id}) }}"
                                           class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-lg hover:scale-105 transition text-sm font-medium shadow-md">
                                            <i class="fa-solid fa-pen"></i>
                                            <span>Edit</span>
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <!-- Empty State (hidden by default, shown when search has no results) -->
                        <div id="emptyState" class="hidden">
                            <div class="empty-state">
                                <i class="fa-solid fa-search"></i>
                                <h3 class="text-xl font-bold text-orange-600 mb-2">No Customers Found</h3>
                                <p class="text-orange-500">Try adjusting your search or filters</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="glass rounded-2xl shadow-xl border border-orange-200 p-12 text-center">
                            <i class="fa-solid fa-user-plus text-6xl text-orange-300 mb-4"></i>
                            <h3 class="text-2xl font-bold text-gray-700 mb-2">No Customers Yet</h3>
                            <p class="text-gray-500 mb-6">Start building your customer base by adding your first customer</p>
                            <a href="{{ path('app_customer_new') }}"
                               class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:scale-105 transition-all duration-200 shadow-lg">
                                <i class="fa-solid fa-plus"></i> Add First Customer
                            </a>
                        </div>
                    {% endif %}
                </div>

                <footer class="mt-10 text-sm text-gray-500 text-center relative z-10">
                    © 2025 <span class="text-orange-500 font-semibold">JULIEKA Admin</span> — All Rights Reserved.
                </footer>
            </main>
        </div>
    </div>

    <script>
        // Mobile menu toggle
        const mobileBtn = document.getElementById('mobileMenuBtn');
        const sidebar = document.querySelector('aside');
        mobileBtn?.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');
        });

        // Search and filter functionality
        const searchInput = document.getElementById('searchInput');
        const customerGrid = document.getElementById('customerGrid');
        const emptyState = document.getElementById('emptyState');
        const customerCount = document.getElementById('customerCount');

        // Only initialize if customer grid exists (not on empty state page)
        if (customerGrid) {
            const customerCards = customerGrid.querySelectorAll('.customer-card');

            function updateCustomerCount() {
                const visibleCards = Array.from(customerCards).filter(card => !card.classList.contains('hidden'));
                customerCount.textContent = visibleCards.length;
                
                if (visibleCards.length === 0) {
                    customerGrid.classList.add('hidden');
                    emptyState.classList.remove('hidden');
                } else {
                    customerGrid.classList.remove('hidden');
                    emptyState.classList.add('hidden');
                }
            }

            // Live Search functionality
            searchInput.addEventListener('input', (e) => {
                const searchTerm = e.target.value.toLowerCase();
                
                customerCards.forEach(card => {
                    const name = card.dataset.name;
                    const email = card.dataset.email;
                    const phone = card.dataset.phone;
                    const address = card.dataset.address;
                    
                    const matches = name.includes(searchTerm) || 
                                   email.includes(searchTerm) || 
                                   phone.includes(searchTerm) || 
                                   address.includes(searchTerm);
                    
                    if (matches) {
                        card.classList.remove('hidden');
                    } else {
                        card.classList.add('hidden');
                    }
                });
                
                updateCustomerCount();
            });

            // Filter functionality (alphabetical)
            const filterChips = document.querySelectorAll('.chip');
            
            filterChips.forEach(chip => {
                chip.addEventListener('click', () => {
                    // Update active state
                    filterChips.forEach(c => c.classList.remove('active'));
                    chip.classList.add('active');
                    
                    const filter = chip.dataset.filter;
                    
                    customerCards.forEach(card => {
                        const name = card.dataset.name;
                        const firstLetter = name.charAt(0).toLowerCase();
                        
                        let show = false;
                        
                        if (filter === 'all') {
                            show = true;
                        } else if (filter === 'a-f') {
                            show = firstLetter >= 'a' && firstLetter <= 'f';
                        } else if (filter === 'g-m') {
                            show = firstLetter >= 'g' && firstLetter <= 'm';
                        } else if (filter === 'n-s') {
                            show = firstLetter >= 'n' && firstLetter <= 's';
                        } else if (filter === 't-z') {
                            show = firstLetter >= 't' && firstLetter <= 'z';
                        }
                        
                        if (show) {
                            card.classList.remove('hidden');
                        } else {
                            card.classList.add('hidden');
                        }
                    });
                    
                    // Clear search when changing filters
                    searchInput.value = '';
                    updateCustomerCount();
                });
            });
        }
    </script>
    {% include 'includes/_live_poll.html.twig' %}
    <script>
      LiveResource.start('{{ path('app_live_customers') }}', '#customerGrid', {
        initialCount: {{ customers|length }},
        onUpdate: (data) => {
          const el = document.getElementById('customerCount');
          if (el && data.count !== undefined) el.textContent = data.count;
        },
        toastTitle: 'Customers updated',
      });
    </script>
</body>
{% endblock %}