{% extends 'base.html.twig' %}

{% block title %}Customer Details{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Lato', sans-serif;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Montserrat', sans-serif;
        }
        .glass {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
    </style>
{% endblock %}

{% block body %}
<body class="antialiased bg-gradient-to-br from-orange-50 via-gray-50 to-orange-200 text-gray-800 min-h-screen">

    <div class="min-h-screen flex">

        <!-- SIDEBAR -->
        <aside class="hidden md:flex flex-col w-80 bg-white shadow-lg border-r border-gray-200 p-5">
      <div class="flex items-center justify-center mb-8">
        <img src="{{ asset('img/PL.png') }}" alt="Logo" class="w-45">
      </div>

            <nav class="flex-1 space-y-2">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
                {% elseif is_granted('ROLE_STAFF') %}
                <a href="{{ path('app_staff_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
                {% endif %}
                <a href="{{ path('app_product_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-box"></i> Products
                </a>
                <a href="{{ path('app_order_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-receipt"></i> Orders
                </a>
                <a href="{{ path('app_stock_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
                    <i class="fa-solid fa-warehouse"></i> Stock
                </a>
                <a href="{{ path('app_customer_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium bg-gradient-to-r from-orange-500 to-orange-400 text-white shadow-md">
                    <i class="fa-solid fa-users"></i> Customers
                </a>
                {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin_users') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-user-shield"></i> User Management
        </a>
        <a href="{{ path('app_admin_records') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-database"></i> All Records
        </a>
        <a href="{{ path('app_admin_activity_logs') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-clipboard-list"></i> Activity Logs
        </a>
        <a href="{{ path('app_settings') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium hover:bg-orange-50 hover:text-orange-600 transition">
          <i class="fa-solid fa-gear"></i> Settings
        </a>
        {% endif %}
            </nav>

            <div class="mt-6">
                <p class="text-xs uppercase text-gray-400 mb-2 font-montserrat tracking-wide">Quick actions</p>
                <a href="{{ path('app_logout') }}" class="w-full py-2 rounded-lg text-white font-medium shadow-md hover:shadow-lg transition transform hover:scale-105 block text-center"
                        style="background: linear-gradient(135deg, #ff7a1f, #ff6600);">
                    <i class="fa-solid fa-right-from-bracket mr-1"></i> Logout
                </a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="flex-1 flex flex-col relative overflow-hidden">

            <!-- Animated background glow -->
            <div class="absolute inset-0 overflow-hidden z-0">
                <div class="absolute w-72 h-72 bg-orange-300 opacity-20 rounded-full blur-3xl top-10 left-20 animate-pulse"></div>
                <div class="absolute w-96 h-96 bg-orange-400 opacity-30 rounded-full blur-3xl bottom-0 right-10 animate-pulse"></div>
            </div>

            <!-- HEADER -->
            <header class="flex items-center justify-between p-5 bg-white/80 backdrop-blur-md shadow-md border-b border-orange-100 sticky top-0 z-10">
                <div class="flex items-center gap-3">
                    <button id="mobileMenuBtn" class="md:hidden p-2 rounded-md hover:bg-gray-100">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="text-2xl font-bold text-gray-800 font-montserrat">Customer Details</h1>
                        <p class="text-sm text-gray-500 font-lato">View complete customer information</p>
                    </div>
                </div>

                 <div class="flex items-center gap-4">
          <div class="relative hidden lg:block">
            <form action="{{ path('app_search') }}" method="GET">
              <input type="text" name="q" placeholder="Search anything..."
                     class="w-72 pl-4 pr-10 py-2.5 rounded-lg border border-gray-200 bg-white text-sm focus:ring-2 focus:ring-orange-400 focus:border-orange-400 focus:outline-none transition font-lato shadow-sm" />
              <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-orange-600 transition">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </form>
          </div>

                    <button class="px-3 py-2 rounded-full bg-white border border-gray-200 hover:bg-orange-50 transition relative shadow-sm">
                        <i class="fa-solid fa-bell text-orange-500"></i>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full animate-ping"></span>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-orange-500 rounded-full"></span>
                    </button>

                    <div class="flex items-center gap-3">
                        <img src="{{ asset('img/Bed.png') }}" alt="avatar" class="w-10 h-10 rounded-full border-2 border-orange-400 object-cover shadow-md" />
                        <div class="hidden sm:block text-sm">
                            <div class="font-semibold text-gray-800 font-lato">{{ app.user.email }}</div>
                            <div class="text-xs text-gray-500 font-lato">
                                {% if is_granted('ROLE_ADMIN') %}
                                  Admin
                                {% elseif is_granted('ROLE_STAFF') %}
                                  Staff
                                {% else %}
                                  User
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- CONTENT -->
            <main class="p-6 md:p-10 flex-1 overflow-y-auto relative z-10">
                <div class="max-w-5xl mx-auto">
                    <!-- Breadcrumb -->
                    <nav class="flex items-center gap-2 text-sm text-gray-600 mb-6">
                        <a href="{{ path('app_customer_index') }}" class="hover:text-orange-600 transition">
                            <i class="fa-solid fa-users"></i> Customers
                        </a>
                        <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
                        <span class="text-orange-600 font-medium">Customer Details</span>
                    </nav>

                    <!-- Customer Profile Header -->
                    <div class="glass rounded-2xl shadow-xl border border-orange-100 p-8 mb-6">
                        <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
                            <!-- Avatar -->
                            <div class="relative">
                                <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center shadow-lg">
                                    <span class="text-4xl font-bold text-white">{{ customer.name|slice(0, 1)|upper }}</span>
                                </div>
                                <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-green-500 rounded-full border-4 border-white flex items-center justify-center">
                                    <i class="fa-solid fa-check text-white text-xs"></i>
                                </div>
                            </div>

                            <!-- Customer Info -->
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <h2 class="text-3xl font-bold text-gray-800">{{ customer.name }}</h2>
                                    <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-semibold">Active</span>
                                </div>
                                <div class="flex flex-wrap gap-4 text-sm text-gray-600">
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-envelope text-orange-500"></i>
                                        <span>{{ customer.emailAddress }}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-phone text-orange-500"></i>
                                        <span>{{ customer.phoneNumber }}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-hashtag text-orange-500"></i>
                                        <span class="text-gray-400">ID: {{ customer.id }}</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="flex gap-2">
                                <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" 
                                   class="px-4 py-2 bg-orange-500 text-white rounded-lg font-semibold hover:bg-orange-600 transition flex items-center gap-2 shadow-md hover:shadow-lg">
                                    <i class="fa-solid fa-pen"></i>
                                    <span>Edit</span>
                                </a>
                                <button onclick="confirmDelete()" 
                                        class="px-4 py-2 bg-white border-2 border-red-500 text-red-600 rounded-lg font-semibold hover:bg-red-50 transition flex items-center gap-2 shadow-md">
                                    <i class="fa-solid fa-trash-alt"></i>
                                    <span>Delete</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Details Grid -->
                    <div class="grid md:grid-cols-2 gap-6 mb-6">
                        <!-- Contact Information -->
                        <div class="glass rounded-2xl shadow-xl border border-orange-100 p-6">
                            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-orange-100">
                                <div class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center">
                                    <i class="fa-solid fa-address-book text-orange-600"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-800">Contact Information</h3>
                            </div>

                            <div class="space-y-4">
                                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg hover:bg-orange-50 transition">
                                    <div class="w-10 h-10 rounded-lg bg-white flex items-center justify-center flex-shrink-0 shadow-sm">
                                        <i class="fa-solid fa-user text-orange-500"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Full Name</p>
                                        <p class="text-gray-800 font-semibold text-lg">{{ customer.name }}</p>
                                    </div>
                                </div>

                                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg hover:bg-orange-50 transition">
                                    <div class="w-10 h-10 rounded-lg bg-white flex items-center justify-center flex-shrink-0 shadow-sm">
                                        <i class="fa-solid fa-envelope text-orange-500"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Email Address</p>
                                        <a href="mailto:{{ customer.emailAddress }}" class="text-orange-600 font-semibold hover:underline break-all">{{ customer.emailAddress }}</a>
                                    </div>
                                </div>

                                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg hover:bg-orange-50 transition">
                                    <div class="w-10 h-10 rounded-lg bg-white flex items-center justify-center flex-shrink-0 shadow-sm">
                                        <i class="fa-solid fa-phone text-orange-500"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Phone Number</p>
                                        <a href="tel:{{ customer.phoneNumber }}" class="text-gray-800 font-semibold hover:text-orange-600 transition">{{ customer.phoneNumber }}</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Address Information -->
                        <div class="glass rounded-2xl shadow-xl border border-orange-100 p-6">
                            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-orange-100">
                                <div class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center">
                                    <i class="fa-solid fa-map-marker-alt text-orange-600"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-800">Address</h3>
                            </div>

                            <div class="flex items-start gap-4 p-6 bg-gradient-to-br from-orange-50 to-white rounded-lg border-2 border-orange-100">
                                <div class="w-12 h-12 rounded-lg bg-white flex items-center justify-center flex-shrink-0 shadow-md">
                                    <i class="fa-solid fa-location-dot text-orange-500 text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Physical Address</p>
                                    <p class="text-gray-800 text-lg leading-relaxed">{{ customer.address }}</p>
                                    <a href="https://www.google.com/maps/search/?api=1&query={{ customer.address|url_encode }}" 
                                       target="_blank"
                                       class="inline-flex items-center gap-2 mt-4 text-orange-600 hover:text-orange-700 font-semibold text-sm transition">
                                        <i class="fa-solid fa-map"></i>
                                        <span>View on Google Maps</span>
                                        <i class="fa-solid fa-external-link-alt text-xs"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Info Cards -->
                    <div class="grid md:grid-cols-3 gap-6 mb-6">
                        <div class="glass rounded-xl shadow-lg border border-orange-100 p-6 text-center hover:shadow-xl transition transform hover:scale-105">
                            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center mx-auto mb-4 shadow-lg">
                                <i class="fa-solid fa-shopping-bag text-white text-2xl"></i>
                            </div>
                            <p class="text-3xl font-bold text-gray-800 mb-1">0</p>
                            <p class="text-sm text-gray-600 font-semibold">Total Orders</p>
                        </div>

                        <div class="glass rounded-xl shadow-lg border border-orange-100 p-6 text-center hover:shadow-xl transition transform hover:scale-105">
                            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center mx-auto mb-4 shadow-lg">
                                <i class="fa-solid fa-dollar-sign text-white text-2xl"></i>
                            </div>
                            <p class="text-3xl font-bold text-gray-800 mb-1">₱0.00</p>
                            <p class="text-sm text-gray-600 font-semibold">Total Spent</p>
                        </div>

                        <div class="glass rounded-xl shadow-lg border border-orange-100 p-6 text-center hover:shadow-xl transition transform hover:scale-105">
                            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center mx-auto mb-4 shadow-lg">
                                <i class="fa-solid fa-calendar text-white text-2xl"></i>
                            </div>
                            <p class="text-3xl font-bold text-gray-800 mb-1">-</p>
                            <p class="text-sm text-gray-600 font-semibold">Last Order</p>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex justify-between items-center gap-4 flex-wrap">
                        <a href="{{ path('app_customer_index') }}" 
                           class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-orange-500 text-orange-600 rounded-lg font-semibold hover:bg-orange-50 transition-all duration-200 shadow-md hover:shadow-lg">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Back to Customer List</span>
                        </a>

                        <div class="flex gap-3">
                            <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" 
                               class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-200 shadow-md">
                                <i class="fa-solid fa-pen-to-square"></i>
                                <span>Edit Customer</span>
                            </a>

                            <button onclick="confirmDelete()" 
                                    class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-red-500 text-red-600 rounded-lg font-semibold hover:bg-red-50 transition-all duration-200 shadow-md hover:shadow-lg">
                                <i class="fa-solid fa-trash-alt"></i>
                                <span>Delete</span>
                            </button>
                        </div>
                    </div>

                    <!-- Hidden Delete Form -->
                    <div id="deleteFormContainer" style="display: none;">
                        {{ include('customer/_delete_form.html.twig') }}
                    </div>
                </div>

                <footer class="mt-10 text-sm text-gray-500 text-center relative z-10">
                    © 2025 <span class="text-orange-500 font-semibold">JULIEKA Admin</span> — All Rights Reserved.
                </footer>
            </main>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 transform transition-all">
            <div class="flex items-center justify-center w-16 h-16 mx-auto bg-red-100 rounded-full mb-4">
                <i class="fa-solid fa-exclamation-triangle text-red-600 text-2xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-800 text-center mb-2">Delete Customer?</h3>
            <p class="text-gray-600 text-center mb-6">Are you sure you want to delete <strong>{{ customer.name }}</strong>? This action cannot be undone.</p>
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()" 
                        class="flex-1 px-4 py-3 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition">
                    Cancel
                </button>
                <button onclick="submitDelete()" 
                        class="flex-1 px-4 py-3 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition">
                    Delete
                </button>
            </div>
        </div>
    </div>

    <script>
        const mobileBtn = document.getElementById('mobileMenuBtn');
        const sidebar = document.querySelector('aside');
        mobileBtn?.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');
        });

        function confirmDelete() {
            const modal = document.getElementById('deleteModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDeleteModal() {
            const modal = document.getElementById('deleteModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function submitDelete() {
            // Try multiple selectors to find the form
            let form = document.querySelector('#deleteFormContainer form');
            
            // If not found, try finding any form with delete method
            if (!form) {
                form = document.querySelector('form[method="post"]');
            }
            
            // If still not found, try finding by action attribute
            if (!form) {
                const forms = document.querySelectorAll('form');
                for (let f of forms) {
                    if (f.action && f.action.includes('delete')) {
                        form = f;
                        break;
                    }
                }
            }
            
            if (form) {
                console.log('Form found, submitting...');
                form.submit();
            } else {
                console.error('Delete form not found!');
                alert('Error: Could not find delete form. Please try again.');
            }
        }

        // Close modal on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeDeleteModal();
            }
        });

        // Debug: Log when page loads to check if form exists
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('#deleteFormContainer form');
            if (form) {
                console.log('Delete form loaded successfully');
            } else {
                console.warn('Delete form not found on page load');
            }
        });
    </script>
</body>
{% endblock %}