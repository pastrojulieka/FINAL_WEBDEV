{% for customer in customers %}
<div class="customer-card bg-white rounded-xl shadow-lg overflow-hidden border-l-4 border-orange-500 hover:shadow-2xl"
     data-name="{{ customer.name|lower }}"
     data-email="{{ customer.emailAddress|lower }}"
     data-phone="{{ customer.phoneNumber|lower }}"
     data-address="{{ customer.address|lower }}">
  <div class="bg-gradient-to-r from-orange-50 to-orange-100 p-5 relative">
    <span class="absolute top-3 right-3 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-full">#{{ customer.id }}</span>
    <div class="flex items-center gap-3">
      <div class="w-16 h-16 rounded-full bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white text-2xl font-bold shadow-lg">{{ customer.name|slice(0, 1)|upper }}</div>
      <h3 class="text-xl font-bold text-gray-800">{{ customer.name }}</h3>
    </div>
  </div>
  <div class="p-5 space-y-3">
    <div class="flex items-start gap-3">
      <i class="fa-solid fa-envelope text-orange-500 w-5 mt-1"></i>
      <div class="flex-1"><div class="text-xs text-gray-500 uppercase mb-1">Email</div><div class="text-sm text-gray-800 font-medium break-words">{{ customer.emailAddress }}</div></div>
    </div>
    <div class="flex items-start gap-3">
      <i class="fa-solid fa-phone text-orange-500 w-5 mt-1"></i>
      <div class="flex-1"><div class="text-xs text-gray-500 uppercase mb-1">Phone</div><div class="text-sm text-gray-800 font-medium">{{ customer.phoneNumber }}</div></div>
    </div>
    <div class="flex items-start gap-3">
      <i class="fa-solid fa-map-marker-alt text-orange-500 w-5 mt-1"></i>
      <div class="flex-1"><div class="text-xs text-gray-500 uppercase mb-1">Address</div><div class="text-sm text-gray-800 font-medium line-clamp-2">{{ customer.address }}</div></div>
    </div>
  </div>
  <div class="p-5 pt-0 flex gap-2">
    <a href="{{ path('app_customer_show', {'id': customer.id}) }}" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 border-2 border-orange-500 text-orange-600 rounded-lg hover:bg-orange-50 transition text-sm font-medium"><i class="fa-solid fa-eye"></i><span>View</span></a>
    <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-lg hover:scale-105 transition text-sm font-medium shadow-md"><i class="fa-solid fa-pen"></i><span>Edit</span></a>
  </div>
</div>
{% else %}
<div class="col-span-full empty-state"><i class="fa-solid fa-inbox"></i><h3 class="text-xl font-bold text-orange-600 mb-2">No Customers Found</h3></div>
{% endfor %}
