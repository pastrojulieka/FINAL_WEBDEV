{% extends 'base.html.twig' %}

{% block title %}Browse Products{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Lato:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .font-montserrat { font-family: 'Montserrat', sans-serif; }
    .font-lato { font-family: 'Lato', sans-serif; }
    
    .product-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(249, 115, 22, 0.2);
    }
    
    .product-image-container {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      transition: all 0.3s ease;
    }
    
    .product-card:hover .product-image-container {
      background: linear-gradient(135deg, #fed7aa 0%, #fdba74 100%);
    }
    
    .search-box {
      position: relative;
    }
    
    .search-input {
      transition: all 0.3s ease;
    }
    
    .search-input:focus {
      box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
    }
    
    .filter-badge {
      transition: all 0.2s ease;
    }
    
    .filter-badge:hover, .filter-badge.active {
      transform: translateY(-2px);
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .fade-in {
      animation: fadeIn 0.5s ease-out forwards;
    }
  </style>
{% endblock %}

{% block body %}
<body class="bg-gradient-to-br from-orange-50 via-white to-orange-100 min-h-screen font-lato">
  
  
  
  {% include 'public/_navigation.html.twig' %}

  <!-- MAIN CONTENT -->
  <main class="max-w-7xl mx-auto px-6 py-8">
    
    <!-- HEADER SECTION -->
    <section class="mb-8 fade-in">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h2 class="text-4xl font-bold text-gray-800 font-montserrat mb-2">
            <i class="fa-solid fa-store text-orange-600 mr-2"></i>
            Browse Products
          </h2>
          <p class="text-gray-600 font-lato">
            <span id="productCount">{{ products|length }}</span> products available in our catalog
          </p>
        </div>
        
        <div class="flex items-center gap-3">
          <button class="px-4 py-2 bg-white border-2 border-orange-200 rounded-lg hover:bg-orange-50 transition font-lato font-medium">
            <i class="fa-solid fa-heart text-orange-500 mr-2"></i>
            Wishlist <span class="ml-1 px-2 py-0.5 bg-orange-100 text-orange-700 rounded-full text-xs">0</span>
          </button>
          <a href="{{ app.user ? path('app_cart') : path('app_login') }}" class="px-4 py-2 bg-white border-2 border-orange-200 rounded-lg hover:bg-orange-50 transition font-lato font-medium inline-flex items-center gap-2">
            <i class="fa-solid fa-shopping-cart text-orange-500 mr-2"></i>
            {{ app.user ? 'Cart' : 'Login to view cart' }} <span id="cartBadge" class="ml-1 px-2 py-0.5 bg-orange-100 text-orange-700 rounded-full text-xs">0</span>
          </a>
        </div>
      </div>
    </section>

    <!-- SEARCH & FILTERS -->
    <section class="mb-8 fade-in" style="animation-delay: 0.1s;">
      <div class="bg-white rounded-2xl shadow-lg border-2 border-orange-100 p-6">
        
        <!-- Search Bar -->
        <div class="search-box mb-6">
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-orange-500 text-lg"></i>
            <input type="text" 
                   id="searchInput" 
                   class="search-input w-full pl-12 pr-4 py-4 border-2 border-orange-200 rounded-xl font-lato text-base focus:border-orange-500 focus:outline-none"
                   placeholder="Search by name, material, color, or description...">
          </div>
        </div>

        <!-- Filter Badges -->
        <div class="flex flex-wrap gap-3">
          <button class="filter-badge active px-4 py-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-full font-lato font-semibold text-sm shadow-md" data-filter="all">
            <i class="fa-solid fa-border-all mr-1"></i> All Products
          </button>
          <button class="filter-badge px-4 py-2 bg-white border-2 border-orange-200 text-orange-700 rounded-full font-lato font-semibold text-sm hover:bg-orange-50" data-filter="price-low">
            <i class="fa-solid fa-arrow-down-short-wide mr-1"></i> Price: Low to High
          </button>
          <button class="filter-badge px-4 py-2 bg-white border-2 border-orange-200 text-orange-700 rounded-full font-lato font-semibold text-sm hover:bg-orange-50" data-filter="price-high">
            <i class="fa-solid fa-arrow-up-wide-short mr-1"></i> Price: High to Low
          </button>
          <button class="filter-badge px-4 py-2 bg-white border-2 border-orange-200 text-orange-700 rounded-full font-lato font-semibold text-sm hover:bg-orange-50" data-filter="name-az">
            <i class="fa-solid fa-arrow-down-a-z mr-1"></i> Name: A-Z
          </button>
          <button class="filter-badge px-4 py-2 bg-white border-2 border-orange-200 text-orange-700 rounded-full font-lato font-semibold text-sm hover:bg-orange-50" data-filter="name-za">
            <i class="fa-solid fa-arrow-up-z-a mr-1"></i> Name: Z-A
          </button>
        </div>
      </div>
    </section>

    <!-- PRODUCTS GRID -->
    {% if products %}
      <section id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 fade-in" style="animation-delay: 0.2s;">
        {% for product in products %}
          <div class="product-card bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-orange-100"
               data-name="{{ product.name|lower }}"
               data-material="{{ product.material|lower }}"
               data-color="{{ product.color|lower }}"
               data-description="{{ product.description|lower }}"
               data-price="{{ product.price }}">
            
            <!-- Image Container -->
            <div class="product-image-container relative h-56 flex items-center justify-center p-4">
              {% if product.image %}
                <img src="{{ asset('img/' ~ product.image) }}" 
                     alt="{{ product.name }}" 
                     class="w-full h-full object-contain">
              {% else %}
                <div class="flex flex-col items-center justify-center text-orange-300">
                  <i class="fa-solid fa-image text-6xl mb-2"></i>
                  <span class="text-sm text-gray-400 font-lato">No image available</span>
                </div>
              {% endif %}
              
              <!-- Favorite Button -->
              <button class="absolute top-3 right-3 w-10 h-10 bg-white rounded-full shadow-lg flex items-center justify-center hover:bg-orange-50 transition">
                <i class="fa-regular fa-heart text-orange-500 text-lg"></i>
              </button>
            </div>

            <!-- Content -->
            <div class="p-5">
              <!-- Product Name -->
              <h3 class="text-lg font-bold text-gray-800 mb-2 font-montserrat truncate">
                {{ product.name }}
              </h3>

              <!-- Description -->
              <p class="text-sm text-gray-600 mb-4 font-lato line-clamp-2 h-10">
                {{ product.description }}
              </p>

              <!-- Product Details -->
              <div class="space-y-2 mb-4 pb-4 border-b-2 border-orange-50">
                <div class="flex items-center gap-2 text-sm font-lato">
                  <i class="fa-solid fa-layer-group text-orange-500 w-4"></i>
                  <span class="text-gray-500">Material:</span>
                  <span class="font-semibold text-gray-800">{{ product.material }}</span>
                </div>
                <div class="flex items-center gap-2 text-sm font-lato">
                  <i class="fa-solid fa-palette text-orange-500 w-4"></i>
                  <span class="text-gray-500">Color:</span>
                  <span class="font-semibold text-gray-800">{{ product.color }}</span>
                </div>
              </div>

              <!-- Price -->
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-baseline gap-1">
                  <i class="fa-solid fa-peso-sign text-orange-600 text-lg"></i>
                  <span class="text-3xl font-bold text-orange-600 font-montserrat">{{ product.price }}</span>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-2">
                <a href="{{ path('app_product_show', {id: product.id}) }}" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-xl hover:shadow-lg transition font-lato font-semibold">
                  <i class="fa-solid fa-eye"></i>
                  <span>View Details</span>
                </a>
                {% if app.user %}
                  <button class="px-4 py-3 bg-orange-100 text-orange-600 rounded-xl hover:bg-orange-200 transition add-to-cart-btn" data-product-id="{{ product.id }}">
                    <i class="fa-solid fa-cart-plus text-lg"></i>
                  </button>
                {% else %}
                  <a href="{{ path('app_login') }}" class="px-4 py-3 bg-orange-100 text-orange-600 rounded-xl hover:bg-orange-200 transition inline-flex items-center justify-center" title="Login to add to cart">
                    <i class="fa-solid fa-right-to-bracket text-lg"></i>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </section>

      <!-- Empty State (shown when no search results) -->
      <div id="emptyState" class="hidden text-center py-16">
        <i class="fa-solid fa-search text-7xl text-orange-200 mb-4"></i>
        <h3 class="text-2xl font-bold text-gray-700 mb-2 font-montserrat">No Products Found</h3>
        <p class="text-gray-500 font-lato">Try adjusting your search terms or filters</p>
      </div>
    {% else %}
      <!-- No Products at All -->
      <div class="bg-white rounded-2xl shadow-lg border-2 border-orange-100 p-16 text-center">
        <i class="fa-solid fa-box-open text-8xl text-orange-200 mb-6"></i>
        <h3 class="text-3xl font-bold text-gray-700 mb-3 font-montserrat">No Products Available</h3>
        <p class="text-gray-500 mb-6 font-lato text-lg">Check back later for new products</p>
        <a href="{{ path('app_user_dashboard') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-xl font-semibold hover:shadow-lg transition font-lato">
          <i class="fa-solid fa-home"></i>
          Back to Dashboard
        </a>
      </div>
    {% endif %}

  </main>

  <!-- FOOTER -->
  <footer class="bg-white border-t-2 border-orange-100 mt-16">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="text-center">
        <p class="text-gray-600 font-lato mb-2">
          © 2025 <span class="text-orange-600 font-bold font-montserrat">Your Company</span>. All rights reserved.
        </p>
        <p class="text-sm text-gray-500 font-lato">
          {% if app.user %}
            Browsing as: <strong class="text-orange-600">{{ app.user.email }}</strong>
          {% else %}
            Browsing as: <strong class="text-orange-600">Guest</strong>
          {% endif %}
        </p>
      </div>
    </div>
  </footer>

  <script>
    // Fetch cart count on page load
    async function refreshCartBadge() {
      try {
        const res = await fetch('{{ path('app_cart_count') }}');
        const data = await res.json();
        if (data.success && data.totalItems !== undefined) {
          const cartBadge = document.querySelector('#cartBadge');
          if (cartBadge) {
            cartBadge.textContent = data.totalItems;
          }
        }
      } catch (e) {
        console.error('Failed to fetch cart count:', e);
      }
    }

    // Add to cart handler
    async function addToCart(productId, qty = 1) {
      try {
        const res = await fetch('{{ path('app_cart_add') }}', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ id: productId, qty: qty })
        });

        const data = await res.json();
        if (data.success) {
          const cartBadge = document.querySelector('#cartBadge');
          if (cartBadge) cartBadge.textContent = data.totalItems;
          // simple feedback
          return true;
        }
        console.error('Add to cart failed', data);
        return false;
      } catch (e) {
        console.error('Add to cart error:', e);
        return false;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Refresh cart badge on load
      refreshCartBadge();

      {% if app.user %}
        // Wire up add to cart buttons (authenticated users only)
        const buttons = document.querySelectorAll('.add-to-cart-btn');
        buttons.forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const productId = btn.dataset.productId;
            if (!productId) {
              console.error('Product ID not found on button');
              return;
            }
            btn.disabled = true;
            const ok = await addToCart(productId);
            btn.disabled = false;
            if (ok) {
              btn.classList.add('ring', 'ring-2', 'ring-orange-300');
              setTimeout(() => btn.classList.remove('ring','ring-2','ring-orange-300'), 800);
            } else {
              alert('Failed to add to cart. Please try again.');
            }
          });
        });
      {% endif %}

      // Search and filter logic
      const searchInput = document.getElementById('searchInput');
      const productGrid = document.getElementById('productGrid');
      const emptyState = document.getElementById('emptyState');
      const productCount = document.getElementById('productCount');
      
      if (searchInput && productGrid) {
        const productCards = productGrid.querySelectorAll('.product-card');
        const filterBadges = document.querySelectorAll('.filter-badge');
        
        function updateProductCount() {
          const visibleCards = Array.from(productCards).filter(card => !card.classList.contains('hidden'));
          productCount.textContent = visibleCards.length;
          
          if (visibleCards.length === 0) {
            productGrid.classList.add('hidden');
            emptyState.classList.remove('hidden');
          } else {
            productGrid.classList.remove('hidden');
            emptyState.classList.add('hidden');
          }
        }
        
        function applySort(filter) {
          const cardsArray = Array.from(productCards);
          
          if (filter === 'price-low') {
            cardsArray.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
          } else if (filter === 'price-high') {
            cardsArray.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
          } else if (filter === 'name-az') {
            cardsArray.sort((a, b) => a.dataset.name.localeCompare(b.dataset.name));
          } else if (filter === 'name-za') {
            cardsArray.sort((a, b) => b.dataset.name.localeCompare(a.dataset.name));
          }
          
          cardsArray.forEach(card => productGrid.appendChild(card));
        }
        
        // Search functionality
        searchInput.addEventListener('input', (e) => {
          const searchTerm = e.target.value.toLowerCase();
          
          productCards.forEach(card => {
            const name = card.dataset.name;
            const material = card.dataset.material;
            const color = card.dataset.color;
            const description = card.dataset.description;
            
            const matches = name.includes(searchTerm) || 
                           material.includes(searchTerm) || 
                           color.includes(searchTerm) || 
                           description.includes(searchTerm);
            
            card.classList.toggle('hidden', !matches);
          });
          
          updateProductCount();
        });
        
        // Filter functionality
        filterBadges.forEach(badge => {
          badge.addEventListener('click', () => {
            // Update active state
            filterBadges.forEach(b => {
              b.classList.remove('active', 'bg-gradient-to-r', 'from-orange-500', 'to-orange-600', 'text-white');
              b.classList.add('bg-white', 'border-2', 'border-orange-200', 'text-orange-700');
            });
            
            badge.classList.add('active', 'bg-gradient-to-r', 'from-orange-500', 'to-orange-600', 'text-white');
            badge.classList.remove('bg-white', 'border-2', 'border-orange-200', 'text-orange-700');
            
            const filter = badge.dataset.filter;
            
            // Show all cards
            productCards.forEach(card => card.classList.remove('hidden'));
            
            // Apply sorting
            if (filter !== 'all') {
              applySort(filter);
            }
            
            // Clear search
            searchInput.value = '';
            updateProductCount();
          });
        });
      }
    });
  </script>
</body>
{% endblock %}