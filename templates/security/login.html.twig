{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}

<style>
    :root {
        --primary-orange: #ff6b35;
        --secondary-orange: #ff8c42;
        --accent-orange: #ffa726;
        --light-orange: #ffe0d6;
        --dark-orange: #e55100;
        --text-dark: #2c2c2c;
        --text-light: #666;
        --white: #ffffff;
        --light-gray: #f8f9fa;
        --border-gray: #e0e0e0;
        --error-red: #dc3545;
        --success-green: #28a745;
    }

    body {
        background: linear-gradient(135deg, var(--light-orange) 0%, #fff5f0 100%);
        min-height: 100vh;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .login-wrapper {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .login-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(255, 107, 53, 0.15);
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 500px;
    }
    
    .logo-section {
        background: linear-gradient(135deg, var(--primary-orange), var(--secondary-orange));
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
    }
    
    .logo-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="40" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="40" cy="80" r="1" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.3;
    }
    
    .logo-container {
        position: relative;
        z-index: 1;
        text-align: center;
    }
    
    .logo-container img {
        max-width: 500px;
        height: auto;
    }
    
    .welcome-text {
        color: var(--white);
        margin-top: 20px;
        font-size: 1.1rem;
        text-align: center;
        font-weight: 300;
        position: relative;
        z-index: 1;
    }
    
    .form-section {
        padding: 50px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    
    .form-header {
        margin-bottom: 32px;
        text-align: center;
    }
    
    .form-title {
        font-size: 2.2rem;
        color: var(--text-dark);
        margin-bottom: 8px;
        font-weight: 600;
    }
    
    .form-subtitle {
        color: var(--text-light);
        font-size: 0.95rem;
    }
    
    .alert {
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }
    
    .alert-danger {
        background-color: #fee;
        border: 2px solid var(--error-red);
        color: var(--error-red);
    }
    
    .alert-success {
        background-color: #e8f5e9;
        border: 2px solid var(--success-green);
        color: var(--success-green);
    }
    
    .logged-in-message {
        background: var(--light-gray);
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        text-align: center;
        border: 2px solid var(--border-gray);
    }
    
    .logged-in-message a {
        color: var(--primary-orange);
        text-decoration: none;
        font-weight: 600;
    }
    
    .logged-in-message a:hover {
        text-decoration: underline;
    }
    
    .form-group {
        margin-bottom: 24px;
    }
    
    .form-label {
        display: block;
        margin-bottom: 8px;
        color: var(--text-dark);
        font-weight: 500;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .form-input {
        width: 100%;
        padding: 16px 20px;
        border: 2px solid var(--border-gray);
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-sizing: border-box;
        background: var(--light-gray);
    }
    
    .form-input:focus {
        outline: none;
        border-color: var(--primary-orange);
        background: var(--white);
        box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.1);
        transform: translateY(-1px);
    }
    
    .submit-btn {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, var(--primary-orange), var(--secondary-orange));
        color: var(--white);
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 8px;
    }
    
    .submit-btn:hover {
        background: linear-gradient(135deg, var(--secondary-orange), var(--accent-orange));
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 107, 53, 0.3);
    }
    
    .submit-btn:active {
        transform: translateY(0);
    }

    .form-links {
        margin-top: 24px;
        text-align: center;
    }
    
    .forgot-password,
    .signup-link {
        margin: 8px 0;
        color: var(--text-light);
        font-size: 0.9rem;
    }
    
    .forgot-password a,
    .signup-link a {
        color: var(--primary-orange);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }
    
    .forgot-password a:hover,
    .signup-link a:hover {
        color: var(--dark-orange);
        text-decoration: underline;
    }
    
    /* Responsive Design */
    @media (max-width: 768px) {
        .login-card {
            grid-template-columns: 1fr;
            max-width: 400px;
        }
        
        .logo-section {
            padding: 30px 20px;
        }
        
        .form-section {
            padding: 40px 30px;
        }
        
        .form-title {
            font-size: 1.8rem;
        }
            
        .logo-container img {
            max-width: 500px;
        }
    }
    
    @media (max-width: 480px) {
        .login-wrapper {
            padding: 10px;
        }
        
        .form-section {
            padding: 30px 20px;
        }
    }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <!-- Logo Section -->
        <div class="logo-section">
            <div class="logo-container">
                <img src="{{ asset('img/SD logo.png') }}" alt="Company Logo">
            </div>
            <div class="welcome-text">
                Welcome back! Please login to continue.
            </div>
        </div>

        <!-- Form Section -->
        <div class="form-section">
            <div class="form-header">
                <h1 class="form-title">Login</h1>
                <p class="form-subtitle">Access your account</p>
            </div>
            
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="logged-in-message">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}
            
            <form method="post">
                <div class="form-group">
                    <label for="inputEmail" class="form-label">Email</label>
                    <input type="email" 
                           value="{{ last_username }}" 
                           name="email" 
                           id="inputEmail" 
                           class="form-input"
                           autocomplete="email"
                           required 
                           autofocus
                           placeholder="Enter your email">
                </div>

                <div class="form-group">
                    <label for="inputPassword" class="form-label">Password</label>
                    <input type="password" 
                           name="password" 
                           id="inputPassword" 
                           class="form-input"
                           autocomplete="current-password"
                           required
                           placeholder="Enter your password">
                </div>
{# 
                <input type="hidden" 
                       name="_csrf_token" 
                       value="{{ csrf_token('authenticate') }}"> #}

                <button type="submit" class="submit-btn">
                    Login
                </button>

                {% if googleClientId %}
                    <div class="mt-6" style="margin-top: 20px; text-align: center;">
                        <p class="form-subtitle" style="margin-bottom: 12px;">
                            Staff sign in with Google
                        </p>
                        <div id="googleSignInButton"></div>
                    </div>

                    <script src="https://accounts.google.com/gsi/client" defer></script>
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            var verifyUrl = '{{ path('app_staff_google_verify') }}';
                            var clientId = '{{ googleClientId }}';

                            function initGoogle() {
                                if (!window.google || !google.accounts || !google.accounts.id) {
                                    setTimeout(initGoogle, 200);
                                    return;
                                }

                                google.accounts.id.initialize({
                                    client_id: clientId,
                                    callback: function (response) {
                                        var id_token = response && response.credential ? response.credential : null;
                                        if (!id_token) {
                                            alert('Google login failed. Missing id_token.');
                                            return;
                                        }

                                        fetch(verifyUrl, {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            credentials: 'same-origin',
                                            body: JSON.stringify({ id_token: id_token })
                                        })
                                            .then(function (r) { return r.json(); })
                                            .then(function (data) {
                                                if (data && data.success && data.redirectUrl) {
                                                    window.location.href = data.redirectUrl;
                                                    return;
                                                }

                                                var msg = data && data.message ? data.message : 'Google login failed';
                                                alert(msg);
                                            })
                                            .catch(function () {
                                                alert('Google login request failed.');
                                            });
                                    }
                                });

                                google.accounts.id.renderButton(
                                    document.getElementById('googleSignInButton'),
                                    { theme: 'outline', size: 'large', text: 'continue_with', shape: 'pill' }
                                );
                            }

                            initGoogle();
                        });
                    </script>
                {% endif %}
                
                <div class="form-links">
                    <p class="forgot-password">
                        Forgot <a href="#">Password</a>?
                    </p>
                    <p class="signup-link">
                        Don't have an account? <a href="{{ path('app_register') }}">Register</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}