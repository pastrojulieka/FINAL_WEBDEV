              </div>
            </div>
          </article>
        </div>

        <div class="mt-10 text-center">
          <a href="{{ path('app_testimonials') }}" class="group inline-flex items-center gap-2 rounded-2xl border-2 border-orange-200 bg-white px-6 py-3 font-semibold text-orange-700 shadow-sm transition hover:border-orange-300 hover:bg-orange-50">
            Read more stories
