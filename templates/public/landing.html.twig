              <i class="fa-solid fa-truck-fast text-2xl text-orange-600"></i>
            </div>
            <h3 class="mb-2 font-montserrat text-xl font-bold text-gray-900">Reliable fulfillment</h3>
            <p class="text-gray-600 leading-relaxed">We work to get your order right and on its way without fuss.</p>
          </div>
        </div>
        <div class="flex flex-col items-center justify-center gap-4 rounded-2xl border border-orange-100 bg-white/90 px-6 py-10 shadow-inner sm:flex-row sm:gap-6">
          <div class="flex max-w-md flex-1 items-center gap-4 text-left">
            <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-orange-100">
              <img src="{{ asset('img/PL.png') }}" alt="" class="h-9 w-auto object-contain" width="36" height="36" />
            </div>
            <div>
              <p class="font-montserrat font-bold text-gray-900">Ready to browse?</p>
              <p class="text-sm text-gray-600">Jump into the catalog or sign in to place an order.</p>
            </div>
          </div>
          <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
            <a href="{{ path('app_user_dashboard') }}" class="inline-flex min-w-[200px] items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-8 py-4 font-semibold text-white shadow-lg shadow-orange-300/40 transition hover:from-orange-600 hover:to-orange-700 hover:shadow-xl">
              <i class="fa-solid fa-bag-shopping"></i>
              Browse Products
            </a>
            <a href="{{ path('app_login') }}" class="inline-flex min-w-[200px] items-center justify-center gap-2 rounded-xl border-2 border-orange-200 bg-white px-8 py-4 font-semibold text-orange-700 transition hover:border-orange-300 hover:bg-orange-50">
              <i class="fa-solid fa-right-to-bracket"></i>
              Login
            </a>
          </div>
        </div>
      </div>
    </section>

    {# TESTIMONIALS #}
    <section id="testimonials" class="relative overflow-hidden rounded-3xl border border-orange-100/80 bg-white shadow-xl shadow-orange-100/50">
      <div class="about-blob -right-20 top-0 h-80 w-80 bg-amber-200"></div>
      <div class="about-blob -bottom-16 -left-16 h-72 w-72 bg-orange-200"></div>
      <div class="relative dot-pattern p-8 md:p-12 lg:p-14">
        <div class="mb-12 text-center md:mb-14">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-orange-600 font-montserrat">Love from our customers</p>
          <h2 class="mb-4 text-4xl font-extrabold text-gray-900 md:text-5xl font-montserrat">
            <span class="bg-gradient-to-r from-orange-600 to-amber-500 bg-clip-text text-transparent">Testimonials</span>
          </h2>
          <p class="mx-auto max-w-2xl text-lg text-gray-600 md:text-xl">
