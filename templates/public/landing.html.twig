{% extends 'base.html.twig' %}

{% block title %}JULIEKA{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Lato:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .font-montserrat { font-family: 'Montserrat', sans-serif; }
    .font-lato { font-family: 'Lato', sans-serif; }
    .hero-gradient { background: linear-gradient(135deg, #ff7a1f 0%, #ff6600 50%, #ff9500 100%); }
    .about-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.35;
      pointer-events: none;
    }
    .dot-pattern {
      background-image: radial-gradient(rgba(249, 115, 22, 0.12) 1px, transparent 1px);
      background-size: 24px 24px;
    }
    .card-lift {
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .card-lift:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 48px -12px rgba(234, 88, 12, 0.22);
    }
    .product-feature-icon {
      background: linear-gradient(145deg, #fff7ed 0%, #ffedd5 100%);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }
    .hero-dot-pattern {
      background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px);
      background-size: 28px 28px;
    }
    .hero-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(72px);
      opacity: 0.45;
      pointer-events: none;
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.25);
    }
    .star-gold {
      color: #fbbf24;
    }
  </style>
{% endblock %}

{% block body %}
<body class="bg-gradient-to-br from-orange-50 via-white to-orange-100 min-h-screen font-lato">
  {% include 'public/_navigation.html.twig' %}

  {# HOME #}
  <section id="home" class="relative overflow-hidden hero-gradient text-white">
    <div class="hero-blob -top-32 left-1/4 h-80 w-80 -translate-x-1/2 bg-amber-300"></div>
    <div class="hero-blob top-1/2 right-0 h-72 w-72 translate-x-1/4 -translate-y-1/2 bg-orange-300"></div>
    <div class="hero-blob bottom-0 left-0 h-64 w-64 -translate-x-1/4 translate-y-1/4 bg-red-400/80"></div>
    <div class="absolute inset-0 hero-dot-pattern opacity-90"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16 md:py-24 lg:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <h1 class="mb-6 text-4xl font-extrabold leading-[1.1] tracking-tight md:text-5xl lg:text-6xl font-montserrat">
            Welcome to <span class="bg-gradient-to-r from-amber-200 via-white to-amber-100 bg-clip-text text-transparent">JULIEKA</span>
          </h1>
          <p class="mb-8 max-w-xl text-lg leading-relaxed text-white/95 md:text-xl">
            Your trusted source for quality products. Discover items crafted with care, backed by service that puts you first.
          </p>
          <div class="mb-10 grid max-w-lg grid-cols-3 gap-3 sm:gap-4">
            <div class="rounded-2xl bg-white/10 px-3 py-4 text-center ring-1 ring-white/20 backdrop-blur-sm sm:px-4">
              <p class="font-montserrat text-2xl font-bold text-white sm:text-3xl">100%</p>
              <p class="mt-1 text-xs text-white/80 sm:text-sm">Commitment</p>
            </div>
            <div class="rounded-2xl bg-white/10 px-3 py-4 text-center ring-1 ring-white/20 backdrop-blur-sm sm:px-4">
              <p class="font-montserrat text-2xl font-bold text-white sm:text-3xl">24/7</p>
              <p class="mt-1 text-xs text-white/80 sm:text-sm">Support</p>
            </div>
            <div class="rounded-2xl bg-white/10 px-3 py-4 text-center ring-1 ring-white/20 backdrop-blur-sm sm:px-4">
              <p class="font-montserrat text-2xl font-bold text-white sm:text-3xl">5★</p>
              <p class="mt-1 text-xs text-white/80 sm:text-sm">Experience</p>
            </div>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
            <a href="#products" class="group inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-8 py-4 text-lg font-semibold text-orange-600 shadow-xl shadow-black/10 transition hover:scale-[1.02] hover:shadow-2xl">
              <i class="fa-solid fa-box"></i>
              View Products
              <i class="fa-solid fa-arrow-down ml-1 text-sm opacity-70 transition group-hover:translate-y-0.5"></i>
            </a>
            <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center gap-2 rounded-2xl border-2 border-white/40 bg-orange-900/40 px-8 py-4 text-lg font-semibold text-white backdrop-blur-sm transition hover:bg-orange-900/60 hover:border-white/60">
              <i class="fa-solid fa-right-to-bracket"></i>
              Login to Order
            </a>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-white/20 to-transparent blur-2xl"></div>
          <div class="glass-card relative overflow-hidden rounded-[1.75rem] p-8 shadow-2xl md:p-10 bg-white/10 backdrop-blur-xl">
            <div class="absolute -right-8 -top-8 text-8xl text-white/10">
              <i class="fa-solid fa-leaf"></i>
            </div>
            <div class="relative flex flex-col items-center text-center gap-4">
              <p class="font-montserrat text-2xl font-bold text-white md:text-3xl">Crafted for you</p>
              <p class="max-w-xs text-sm text-white/85 md:text-base">
                From selection to delivery, we focus on the details that make every order worthwhile.
              </p>
              <div class="mt-6 flex w-full flex-col gap-3 sm:flex-row sm:justify-center">
                <a href="#about" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white/90 px-5 py-3 text-sm font-semibold text-orange-600 transition hover:bg-white">
                  <i class="fa-solid fa-circle-info"></i>
                  About us
                </a>
                <a href="#contact" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white/10 px-5 py-3 text-sm font-semibold text-white ring-1 ring-white/30 transition hover:bg-white/20">
