{% extends 'base.html.twig' %}

{% block title %}Contact Us{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Lato:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .font-montserrat { font-family: 'Montserrat', sans-serif; }
    .font-lato { font-family: 'Lato', sans-serif; }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .fade-in {
      animation: fadeIn 0.6s ease-out forwards;
    }
    
    .form-input {
      transition: all 0.3s ease;
    }
    
    .form-input:focus {
      box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
    }
  </style>
{% endblock %}

{% block body %}
<body class="bg-gradient-to-br from-orange-50 via-white to-orange-100 min-h-screen font-lato">
  
  {% include 'public/_navigation.html.twig' %}

  <!-- HERO SECTION -->
  <section class="bg-gradient-to-r from-orange-500 to-orange-600 text-white py-20 fade-in">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6 font-montserrat">Contact Us</h1>
      <p class="text-xl md:text-2xl font-lato opacity-95 max-w-3xl mx-auto">
        We'd love to hear from you! Get in touch with our team for any questions, feedback, or inquiries.
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <main class="max-w-7xl mx-auto px-6 py-16">
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Contact Form -->
      <div class="lg:col-span-2 fade-in" style="animation-delay: 0.1s;">
        <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12 border-2 border-orange-100">
          <h2 class="text-3xl font-bold text-gray-800 mb-6 font-montserrat">
            <i class="fa-solid fa-envelope text-orange-600 mr-2"></i>
            Send us a Message
          </h2>

          {% if googleFormsEmbedUrl %}
            <p class="text-lg text-gray-700 mb-6 font-lato">
              Please use the form below. After submission, you will see confirmation inside the embedded form.
            </p>

            <div class="w-full rounded-xl overflow-hidden border-2 border-orange-100 bg-white">
              <iframe
                src="{{ googleFormsEmbedUrl }}"
                title="Contact Form"
                class="w-full"
                style="min-height: 650px; border: 0;"
                loading="lazy"
              ></iframe>
            </div>

            <p class="text-sm text-gray-500 mt-4 font-lato">
              If the embedded form doesn't load, you can open it in a new tab:
              <a href="{{ googleFormsEmbedUrl }}" class="text-orange-600 hover:underline" target="_blank" rel="noopener">Open form</a>.
            </p>
          {% else %}
            {% if success %}
              <div class="mb-6 p-4 bg-green-100 border-2 border-green-400 text-green-700 rounded-lg">
                <i class="fa-solid fa-check-circle mr-2"></i>
                <strong>Thank you!</strong> Your message has been sent successfully. We'll get back to you soon.
              </div>
            {% endif %}
            
            {% if error %}
              <div class="mb-6 p-4 bg-red-100 border-2 border-red-400 text-red-700 rounded-lg">
                <i class="fa-solid fa-exclamation-circle mr-2"></i>
                {{ error }}
              </div>
            {% endif %}
            
            <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSdblmr3CNquoFnxI-1W-wsDOl_FgjOAf1MzvWh62sGjC1EGYQ/viewform?embedded=true" width="640" height="820" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>
          {% endif %}
        </div>
      </div>
      
      <!-- Contact Information -->
      <div class="fade-in" style="animation-delay: 0.2s;">
        <div class="bg-white rounded-2xl shadow-lg p-8 border-2 border-orange-100 sticky top-24">
          <h2 class="text-2xl font-bold text-gray-800 mb-6 font-montserrat">
            <i class="fa-solid fa-address-card text-orange-600 mr-2"></i>
            Get in Touch
          </h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-envelope text-white"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800 mb-1 font-lato">Email</h3>
                <p class="text-gray-600 font-lato">contact@julieka.com</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-phone text-white"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800 mb-1 font-lato">Phone</h3>
                <p class="text-gray-600 font-lato">+1 (555) 123-4567</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-clock text-white"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800 mb-1 font-lato">Business Hours</h3>
                <p class="text-gray-600 font-lato text-sm">
                  Monday - Friday: 9:00 AM - 6:00 PM<br>
                  Saturday: 10:00 AM - 4:00 PM<br>
                  Sunday: Closed
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-map-marker-alt text-white"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800 mb-1 font-lato">Address</h3>
                <p class="text-gray-600 font-lato text-sm">
                  123 Business Street<br>
                  City, State 12345<br>
                  Country
                </p>
              </div>
            </div>
          </div>
          
          <div class="mt-8 pt-8 border-t-2 border-orange-100">
            <h3 class="font-semibold text-gray-800 mb-4 font-lato">Follow Us</h3>
            <div class="flex gap-3">
              <a href="#" class="w-10 h-10 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center hover:bg-orange-200 transition">
                <i class="fa-brands fa-facebook"></i>
              </a>
              <a href="#" class="w-10 h-10 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center hover:bg-orange-200 transition">
                <i class="fa-brands fa-twitter"></i>
              </a>
              <a href="#" class="w-10 h-10 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center hover:bg-orange-200 transition">
                <i class="fa-brands fa-instagram"></i>
              </a>
              <a href="#" class="w-10 h-10 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center hover:bg-orange-200 transition">
                <i class="fa-brands fa-linkedin"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
      
    </div>
    
  </main>

  <!-- FOOTER -->
  <footer class="bg-white border-t-2 border-orange-100 mt-16">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="text-center">
        <p class="text-gray-600 font-lato mb-2">
          © 2025 <span class="text-orange-600 font-bold font-montserrat">JULIEKA</span>. All rights reserved.
        </p>
        {% if app.user %}
          <p class="text-sm text-gray-500 font-lato">
            Logged in as: <strong class="text-orange-600">{{ app.user.email }}</strong>
          </p>
        {% endif %}
      </div>
    </div>
  </footer>

</body>
{% endblock %}

